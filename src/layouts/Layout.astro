---
import '../styles/global.css';
import { site, pick, validate, versions, defaultVersion } from '../lib/content';
import { edition, otherEditionUrl } from '../lib/edition';
import ProcessHover from '../components/ProcessHover.astro';
import { useTranslations, languageNames, languageIn, locales, href, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  section?: 'processes' | 'workProducts' | 'lifecycles' | 'tailor' | 'compare' | 'references';
  /** Current PRM version and where each version's equivalent page lives. */
  version?: string;
  versionLinks?: Record<string, string>;
  /** False when the page shows English text in place of a missing translation. */
  translated?: boolean;
}

const { locale, title, description, section, version, versionLinks, translated = true } = Astro.props;
const t = useTranslations(locale);
const siteTitle = pick(site.title, locale);
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;

// Fail the build on broken cross-references, once per build.
const errors = (globalThis as any).__prmValidation ??= validate();
if (errors.length) throw new Error(`Content errors:\n${errors.join('\n')}`);

// Same page in the other languages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(base.length).split('/').slice(2).join('/');
const languageLinks = locales.map((l) => ({ locale: l, href: `${base}/${l}/${rest}` }));

const navVersion = version ?? defaultVersion;
// The same page under /latest/, which always forwards to the default version.
const latestLink = versionLinks?.[defaultVersion]?.replace(`/${locale}/${defaultVersion}/`, `/${locale}/latest/`);
const nav = [
  ['processes', href(locale, navVersion)],
  ['workProducts', href(locale, navVersion, 'work-products')],
  ['compare', href(locale, 'compare')],
  ['lifecycles', href(locale, 'lifecycles')],
  ['tailor', href(locale, 'tailor')],
  ['references', href(locale, 'references')],
] as const;
const repo = import.meta.env.PUBLIC_REPO ? `https://github.com/${import.meta.env.PUBLIC_REPO}` : undefined;
const otherEdition = otherEditionUrl && `${otherEditionUrl}${locale}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? pick(site.intro, locale)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* Searches lead to the live edition; the thesis edition is reached from the thesis. */}
    {edition === 'thesis' && <meta name="robots" content="noindex" />}
    {languageLinks.map((l) => <link rel="alternate" hreflang={l.locale} href={l.href} />)}
    <script is:inline>
      // Apply the saved theme before the first paint. Without a saved choice
      // the page follows the system setting through prefers-color-scheme.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    {
      edition === 'thesis' && (
        <div class="edition-banner">
          <div class="container">
            <span class="label">{t('edition.thesis')}</span>
            <span>{t('edition.banner')}</span>
            {otherEdition && <a href={otherEdition}>{t('edition.goLive')} →</a>}
          </div>
        </div>
      )
    }
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={href(locale)}>
          <span class="brand-code" aria-hidden="true">ML-PRM</span>
          <span>{siteTitle}</span>
        </a>
        <div class="switchers">
          {
            version && versionLinks && (
              <details class="menu">
                <summary aria-label={`${t('nav.version')}: ${version}`}>
                  {version}
                  {version === defaultVersion && <span class="menu-note">· {t('nav.latest')}</span>}
                </summary>
                <ul>
                  {latestLink && (
                    <li>
                      <a href={latestLink}>
                        <span class="menu-key">{t('nav.latest')}</span>
                        <span class="menu-note">{defaultVersion}</span>
                      </a>
                    </li>
                  )}
                  {versions.map((v) =>
                    versionLinks[v.id] ? (
                      <li>
                        <a href={versionLinks[v.id]} aria-current={v.id === version ? 'true' : undefined}>
                          <span class="menu-key">{v.id}</span>
                          <span class="menu-note">{pick(v.title, locale)}</span>
                        </a>
                      </li>
                    ) : null,
                  )}
                </ul>
              </details>
            )
          }
          <button type="button" class="theme-toggle" id="theme-toggle" data-label-dark={t('nav.theme-dark')} data-label-light={t('nav.theme-light')} aria-label={t('nav.theme-dark')} title={t('nav.theme-dark')}>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
          </button>
          <details class="menu">
            <summary aria-label={`${t('nav.language')}: ${languageNames[locale]}`}>{locale.toUpperCase()}</summary>
            <ul>
              {
                languageLinks.map((l) => (
                  <li>
                    <a href={l.href} hreflang={l.locale} lang={l.locale} aria-current={l.locale === locale ? 'true' : undefined}>
                      <span class="menu-key">{l.locale.toUpperCase()}</span>
                      <span class="menu-note">{languageNames[l.locale]}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
      <nav class="main-nav" aria-label="Main">
        <div class="container">
          <ul>
            {
              nav.map(([key, url]) => (
                <li>
                  <a href={url} aria-current={section === key ? 'page' : undefined}>
                    {t(`nav.${key}`)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </header>
    <main id="main">
      <div class="container">
        {!translated && <p class="notice">{t('i18n.untranslated', { language: languageIn(locale, locale) })}</p>}
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="title-block">
          <div>
            <span class="label">{t('footer.thesis')}</span>
            {site.author}
          </div>
          {
            site.institution && (
              <div>
                <span class="label">{t('footer.institution')}</span>
                {site.institution}
              </div>
            )
          }
          <div>
            <span class="label">{t('footer.licence')}</span>
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">{t('footer.license')}</a>
          </div>
          <div>
            <span class="label">{t('footer.links')}</span>
            {repo && <a href={repo}>{t('footer.source')}</a>}
            {repo && ' · '}
            <a href={`${base}/admin/`}>{t('nav.admin')}</a>
            {edition === 'live' && otherEdition && (
              <>
                {' · '}
                <a href={otherEdition}>{t('edition.thesisLink')}</a>
              </>
            )}
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (system.matches ? 'dark' : 'light');
        const sync = () => {
          const label = current() === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
          button.setAttribute('aria-label', label);
          button.title = label;
          button.dataset.current = current();
        };
        button.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        });
        system.addEventListener('change', sync);
        sync();
      })();
      // Close the header menus on a click outside them or on Escape.
      (() => {
        const menus = [...document.querySelectorAll('.site-header details.menu')];
        document.addEventListener('click', (e) => {
          for (const m of menus) if (m.open && !m.contains(e.target)) m.open = false;
        });
        document.addEventListener('keydown', (e) => {
          const m = menus.find((x) => x.open);
          if (e.key !== 'Escape' || !m) return;
          m.open = false;
          m.querySelector('summary').focus();
        });
        // Opening one menu closes the other.
        for (const m of menus) m.addEventListener('toggle', () => m.open && menus.forEach((x) => x !== m && (x.open = false)));
      })();
    </script>
    <ProcessHover locale={locale} />
  </body>
</html>
