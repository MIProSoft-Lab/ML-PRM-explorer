---
import Layout from '../../../layouts/Layout.astro';
import { getVersion, getProcess, pick, versions } from '../../../lib/content';
import { versionPaths } from '../../../lib/paths';
import { plain } from '../../../lib/text';
import { useTranslations, href, type Locale } from '../../../i18n/ui';

export const getStaticPaths = versionPaths;
const locale = Astro.props.locale as Locale;
const { version } = Astro.params as { version: string };
const t = useTranslations(locale);
const v = getVersion(version);

const tile = (id: string) => {
  const { data: p, translated } = getProcess(version, id, locale);
  const search = [p.name, p.purpose, ...p.outcomes.map((o) => o.text), ...p.activities.map((a) => `${a.title} ${a.description}`)]
    .map(plain)
    .join(' ')
    .toLowerCase();
  return { p, translated, search };
};
const groups = v.topology.map((g) => ({ name: pick(g.group, locale), columns: g.columns.map((c) => c.map(tile)) }));
const translated = groups.every((g) => g.columns.every((c) => c.every((x) => x.translated)));
const versionLinks = Object.fromEntries(versions.map((x) => [x.id, href(locale, x.id)]));
const origins = ['standards-and-literature', 'standards-only', 'decomposed'] as const;
---

<Layout locale={locale} title={`${t('map.title')} ${version}`} section="processes" version={version} versionLinks={versionLinks} translated={translated}>
  <h1>{t('map.title')} <span class="muted">· {pick(v.title, locale)}</span></h1>
  <p class="muted prose">{pick(v.description, locale)}</p>

  <div class="toolbar">
    <label class="visually-hidden" for="q">{t('map.search')}</label>
    <input id="q" type="search" placeholder={t('map.search')} autocomplete="off" />
    <div class="legend" aria-label={t('map.legend')}>
      {
        origins.map((o) => (
          <span title={t(`origin.${o}.long`)}>
            <span class={`swatch origin-${o}`} />
            {t(`origin.${o}`)}
          </span>
        ))
      }
    </div>
  </div>

  {
    groups.map((g) => (
      <section class="group">
        <h2>{g.name}</h2>
        <div class="columns">
          {g.columns.map((col) => (
            <ol class="column">
              {col.map(({ p, search }) => (
                <li data-search={search}>
                  <a class={`tile origin-${p.origin}`} href={href(locale, version, 'processes', p.id)} title={t(`origin.${p.origin}.long`)}>
                    <span class="num">{p.id}</span>
                    <span class="name">{p.name}</span>
                    <span class="meta">
                      {p.activities.length} {t('map.activities')}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))
  }
  <p id="empty" class="muted" hidden>{t('map.noResults')}</p>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const apply = () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const match = words.every((w) => el.dataset.search!.includes(w));
      el.classList.toggle('dim', !match);
      if (match) shown++;
    }
    empty.hidden = shown > 0;
  };
  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    margin: 16px 0 8px;
  }

  .toolbar input {
    flex: 1 1 280px;
    max-width: 460px;
  }

  .group {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 4px 16px 16px;
    margin-top: 16px;
  }

  .group h2 {
    text-align: center;
    margin: 12px 0;
    font-size: 1.15rem;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 10px 16px;
    align-items: start;
  }

  .column {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .tile {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'num name' '. meta';
    column-gap: 10px;
    min-height: 64px;
    align-content: center;
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition:
      transform 0.12s ease,
      opacity 0.15s ease;
  }

  .tile:hover {
    transform: translateY(-1px);
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }

  .tile .num {
    grid-area: num;
    font-family: var(--mono);
    font-size: 0.8rem;
    opacity: 0.75;
    padding-top: 2px;
  }

  .tile .name {
    grid-area: name;
    font-weight: 600;
    line-height: 1.3;
  }

  .tile .meta {
    grid-area: meta;
    font-size: 0.78rem;
    opacity: 0.75;
  }

  .dim .tile {
    opacity: 0.25;
  }
</style>
