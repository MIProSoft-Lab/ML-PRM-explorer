---
import Layout from '../../../layouts/Layout.astro';
import ProcessModal from '../../../components/ProcessModal.astro';
import { getVersion, getProcess, pick, versions } from '../../../lib/content';
import { versionPaths } from '../../../lib/paths';
import { plain } from '../../../lib/text';
import { useTranslations, href, type Locale } from '../../../i18n/ui';

export const getStaticPaths = versionPaths;
const locale = Astro.props.locale as Locale;
const { version } = Astro.params as { version: string };
const t = useTranslations(locale);
const v = getVersion(version);

const tile = (id: string) => {
  const { data: p, translated } = getProcess(version, id, locale);
  const search = [p.name, p.purpose, ...p.outcomes.map((o) => o.text), ...p.activities.map((a) => `${a.title} ${a.description}`)]
    .map(plain)
    .join(' ')
    .toLowerCase();
  return { p, translated, search };
};
const groups = v.topology.map((g) => ({ name: pick(g.group, locale), columns: g.columns.map((c) => c.map(tile)) }));
const translated = groups.every((g) => g.columns.every((c) => c.every((x) => x.translated)));
const versionLinks = Object.fromEntries(versions.map((x) => [x.id, href(locale, x.id)]));
const origins = ['standards-and-literature', 'standards-only', 'decomposed'] as const;
---

<Layout locale={locale} title={`${t('map.title')} ${version}`} section="processes" version={version} versionLinks={versionLinks} translated={translated}>
  <p class="breadcrumbs">ML-PRM / {version}</p>
  <h1>{t('map.title')} <span class="muted">· {pick(v.title, locale)}</span></h1>
  <p class="muted prose">{pick(v.description, locale)}</p>

  <div class="toolbar">
    <label class="visually-hidden" for="q">{t('map.search')}</label>
    <input id="q" type="search" placeholder={t('map.search')} autocomplete="off" />
    <div class="legend" aria-label={t('map.legend')}>
      {
        origins.map((o) => (
          <span title={t(`origin.${o}-long`)}>
            <span class={`swatch origin-${o}`} />
            {t(`origin.${o}`)}
          </span>
        ))
      }
    </div>
  </div>

  {
    groups.map((g) => (
      <section class="group grid-paper">
        <h2 class="group-label">{g.name}</h2>
        <div class="columns">
          {g.columns.map((col) => (
            <ol class="column">
              {col.map(({ p, search }) => (
                <li data-search={search}>
                  <a class="node" href={href(locale, version, 'processes', p.id)} data-process={p.id} data-version={version} data-name={p.name}>
                    <span class={`node-tab origin-${p.origin}`}>
                      <span>{p.id}</span>
                      <span>
                        {p.activities.length} {t('map.activities')}
                      </span>
                    </span>
                    <span class="node-name">{p.name}</span>
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))
  }
  <p id="empty" class="muted" hidden>{t('map.noResults')}</p>
  <ProcessModal locale={locale} />
</Layout>

<script>
  import { createProcessModal, openLinksInModal } from '../../../lib/process-modal';

  openLinksInModal(document.getElementById('main')!, createProcessModal());

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const apply = () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const match = words.every((w) => el.dataset.search!.includes(w));
      el.classList.toggle('dim', !match);
      if (match) shown++;
    }
    empty.hidden = shown > 0;
  };
  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    margin: 20px 0 16px;
  }

  .toolbar input {
    flex: 1 1 280px;
    max-width: 460px;
  }

  .group {
    border: 1px solid var(--ink);
    padding: 44px 24px 24px;
    margin-top: 8px;
    position: relative;
  }

  /* The group name sits in a tab on the frame, like a drawing label. */
  .group-label {
    position: absolute;
    top: -1px;
    left: -1px;
    margin: 0;
    padding: 4px 12px;
    background: var(--ink);
    color: var(--surface);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .group-label::after {
    display: none;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px 28px;
    align-items: start;
  }

  .column {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .node {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--ink);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease,
      opacity 0.15s ease;
  }

  .node:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--lift);
  }

  .node-tab {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 8px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .node-tab span:last-child {
    opacity: 0.8;
  }

  .node-name {
    padding: 8px 10px 10px;
    font-weight: 600;
    line-height: 1.3;
    min-height: 3.2em;
  }

  .dim .node {
    opacity: 0.25;
  }

  @media (max-width: 600px) {
    .group {
      padding: 40px 12px 12px;
    }

    .node-name {
      min-height: 0;
    }
  }
</style>
