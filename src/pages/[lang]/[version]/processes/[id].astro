---
import Layout from '../../../../layouts/Layout.astro';
import { getProcess, getVersion, getWorkProducts, processIds, versions, pick } from '../../../../lib/content';
import { processPaths } from '../../../../lib/paths';
import { inline, plain } from '../../../../lib/text';
import { referenceByKey, shortCite, studyById } from '../../../../lib/refs';
import { useTranslations, href, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = processPaths;
const locale = Astro.props.locale as Locale;
const { version, id } = Astro.params as { version: string; id: string };
const t = useTranslations(locale);
const { data: p, translated } = getProcess(version, id, locale);
const v = getVersion(version);

const wps = new Map(getWorkProducts(version, locale).map((w) => [w.id, w]));
const name = (pid: string) => getProcess(version, pid, locale).data.name;
// Workshop decisions with a label; anything else, such as "–", is shown as written.
const decisions = ['adopted', 'partial', 'rejected', 'deferred'];
const decisionLabel = (d: string) => (decisions.includes(d) ? t(`decision.${d}`) : d);

// Traceability lives in the version that was traced against the standards.
const traced = p.standards
  ? { version, rows: p.standards }
  : versions
      .map((x) => x.id)
      .filter((x) => x !== version && processIds(x).includes(id))
      .map((x) => ({ version: x, rows: getProcess(x, id, locale).data.standards }))
      .find((x) => x.rows?.length);
const tracedActivities = traced && traced.version !== version ? getProcess(traced.version, id, locale).data.activities : p.activities;
const activityTitle = (aid?: string) => tracedActivities.find((a) => a.id === aid)?.title;

const ids = processIds(version);
const i = ids.indexOf(id);
const prev = ids[i - 1];
const next = ids[i + 1];

const versionLinks = Object.fromEntries(
  versions.map((x) => [x.id, processIds(x.id).includes(id) ? href(locale, x.id, 'processes', id) : href(locale, x.id)]),
);
const otherVersions = versions.filter((x) => x.id !== version && processIds(x.id).includes(id));
const comparePair = (other: string) => {
  const order = versions.map((x) => x.id);
  return order.indexOf(other) < order.indexOf(version) ? `${other}-vs-${version}` : `${version}-vs-${other}`;
};

// Work products that support each outcome, from the serves lists.
const servedBy = (oid: string) => [
  ...p.inputs.filter((io) => io.serves.includes(oid)).map((io) => ({ ...io, dir: 'in' })),
  ...p.outputs.filter((io) => io.serves.includes(oid)).map((io) => ({ ...io, dir: 'out' })),
];
const wpHref = (wid: string) => `${href(locale, version, 'work-products')}#${wid}`;

// Numbered sections, as on a drawing sheet.
const sections = [
  ['purpose', t('process.purpose')],
  ['outcomes', t('process.outcomes')],
  ['interface', `${t('process.inputs')} · ${t('process.outputs')}`],
  ['activities', t('process.activities')],
  ...(traced ? [['standards', t('process.standards')]] : []),
  ...(p.changes?.length ? [['changes', t('process.changes')]] : []),
] as [string, string][];
const num = (key: string) => String(sections.findIndex(([k]) => k === key) + 1).padStart(2, '0');
---

<Layout locale={locale} title={p.name} description={plain(p.purpose)} section="processes" version={version} versionLinks={versionLinks} translated={translated}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href(locale, version)}>ML-PRM / {version}</a> / {p.id}
  </nav>

  <h1>{p.name}</h1>

  <dl class="sheet title-block">
    <div>
      <dt class="label">{t('process.sheet-process')}</dt>
      <dd class="mono">{p.id}</dd>
    </div>
    <div>
      <dt class="label">{t('nav.version')}</dt>
      <dd><span class="mono">{version}</span> · {pick(v.title, locale)}</dd>
    </div>
    <div>
      <dt class="label">{t('map.legend')}</dt>
      <dd><span class={`badge origin-${p.origin}`} title={t(`origin.${p.origin}-long`)}>{t(`origin.${p.origin}`)}</span></dd>
    </div>
    <div>
      <dt class="label">{t('process.sheet-sheet')}</dt>
      <dd class="mono">{String(i + 1).padStart(2, '0')} / {String(ids.length).padStart(2, '0')}</dd>
    </div>
    {
      otherVersions.length > 0 && (
        <div class="no-print">
          <dt class="label">{t('process.otherVersions')}</dt>
          <dd>
            {otherVersions.map((o) => (
              <a href={href(locale, 'compare', comparePair(o.id), id)}>{t('process.compare', { version: o.id })}</a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  <div class="layout">
    <aside class="toc no-print" aria-label="Contents">
      <ol>
        {
          sections.map(([key, label]) => (
            <li>
              <a href={`#${key}`}>
                <span class="mono">{num(key)}</span> {label}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <article class="content">
      <section id="purpose">
        <h2><span class="sec">{num('purpose')}</span>{t('process.purpose')}</h2>
        <p class="prose purpose" set:html={inline(p.purpose)} />
      </section>

      <section id="outcomes">
        <h2><span class="sec">{num('outcomes')}</span>{t('process.outcomes')}</h2>
        <ol class="outcomes">
          {
            p.outcomes.map((o) => (
              <li id={`outcome-${o.id}`}>
                <span class="letter">{o.id}</span>
                <div>
                  <span set:html={inline(o.text)} />
                  {servedBy(o.id).length > 0 && (
                    <div class="chips served" aria-label={t('process.outcomeServedBy')}>
                      {servedBy(o.id).map((io) => (
                        <a class="chip" href={`#${io.dir === 'in' ? 'input' : 'output'}-${io.workProduct}`}>
                          <span class="num">{io.dir === 'in' ? 'IN' : 'OUT'}</span>
                          {io.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="interface">
        <h2><span class="sec">{num('interface')}</span>{t('process.inputs')} · {t('process.outputs')}</h2>
        <div class="flow grid-paper">
          {
            (['inputs', 'outputs'] as const).map((kind) => (
              <div class:list={['flow-col', kind]} id={kind}>
                <span class="label col-label">{t(`process.${kind}`)}</span>
                {p[kind].length === 0 && <p class="muted small">—</p>}
                {p[kind].map((io) => {
                  const wp = wps.get(io.workProduct);
                  const links = kind === 'inputs' ? wp?.producers : wp?.consumers.filter((c) => c.process !== id);
                  return (
                    <div class="io-node" id={`${kind === 'inputs' ? 'input' : 'output'}-${io.workProduct}`}>
                      <div class="io-head">
                        <a class="io-name" href={wpHref(io.workProduct)}>
                          {io.name}
                        </a>
                        {io.serves.length > 0 && (
                          <span class="serves" title={t('process.serves')}>
                            {io.serves.map((s) => (
                              <a href={`#outcome-${s}`}>{s}</a>
                            ))}
                          </span>
                        )}
                      </div>
                      <div class="io-tags">
                        {wp && <span class="badge">{t(`wp.type-${wp.type}`)}</span>}
                        {io.optional && <span class="badge">{t('process.optional')}</span>}
                      </div>
                      {io.description && <p class="io-desc" set:html={inline(io.description)} />}
                      <div class="io-links">
                        <span class="label">{kind === 'inputs' ? t('process.producedBy') : t('process.usedBy')}</span>
                        {links && links.length > 0 ? (
                          <span class="chips">
                            {links.map((l) => (
                              <a class="chip" href={href(locale, version, 'processes', l.process)}>
                                <span class="num">{l.process}</span>
                                <span class="link-name">{name(l.process)}</span>
                              </a>
                            ))}
                          </span>
                        ) : (
                          <span class="muted small">{kind === 'inputs' ? t('process.external') : t('process.notUsed')}</span>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            ))
          }
          <svg class="wires" aria-hidden="true">
            <defs>
              <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
                <path d="M0 0 L8 4 L0 8 z" fill="currentColor" />
              </marker>
            </defs>
          </svg>
          <div class="flow-core" aria-hidden="true">
            <div class="core-box">
              <span class="mono core-id">{p.id}</span>
              <span class="core-name">{p.name}</span>
              <span class="core-outcomes mono">{p.outcomes.map((o) => o.id).join(' ')}</span>
            </div>
          </div>
        </div>
      </section>

      <section id="activities">
        <div class="section-head">
          <h2><span class="sec">{num('activities')}</span>{t('process.activities')}</h2>
          <button type="button" class="toggle-all no-print" data-expand={t('process.expandAll')} data-collapse={t('process.collapseAll')}>
            {t('process.collapseAll')}
          </button>
        </div>
        <ol class="activities">
          {
            p.activities.map((a) => (
              <li id={`activity-${a.id}`}>
                <details open>
                  <summary>
                    <span class="aid">{a.id}</span>
                    <span class="atitle" set:html={inline(a.title)} />
                  </summary>
                  <div class="abody">
                    <p class="prose" set:html={inline(a.description)} />
                    {(a.primaryStudies?.length || a.literature?.length) && (
                      <dl class="sources small">
                        {a.primaryStudies?.length ? (
                          <>
                            <dt class="label">{t('process.primaryStudies')}</dt>
                            <dd class="chips">
                              {a.primaryStudies.map((s) => (
                                <a class="chip" href={`${href(locale, 'references')}#${s}`} title={studyById.get(s)?.title}>
                                  <span class="num">{s}</span>
                                </a>
                              ))}
                            </dd>
                          </>
                        ) : null}
                        {a.literature?.length ? (
                          <>
                            <dt class="label">{t('process.literature')}</dt>
                            <dd class="chips">
                              {a.literature.map((k) => (
                                <a class="chip" href={`${href(locale, 'references')}#${k}`} title={referenceByKey.get(k)?.title}>
                                  {shortCite(referenceByKey.get(k), k)}
                                </a>
                              ))}
                            </dd>
                          </>
                        ) : null}
                      </dl>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
      </section>

      {
        traced && (
          <section id="standards">
            <h2>
              <span class="sec">{num('standards')}</span>
              {t('process.standards')}
            </h2>
            <p class="muted small">
              {t('process.standardsNote')} {traced.version !== version && t('process.standardsV1', { version: traced.version })}
            </p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{t('process.standard')}</th>
                    <th>{t('process.standardActivity')}</th>
                    <th>{t('process.prmActivity')}</th>
                  </tr>
                </thead>
                <tbody>
                  {traced.rows!.map((r) => (
                    <tr>
                      <td class="nowrap">
                        <span class="mono small">{r.standard}</span>
                        {r.standardProcess && <div class="muted small">{r.standardProcess}</div>}
                      </td>
                      <td>{r.activity || <span class="muted">{t('process.noStandardActivity')}</span>}</td>
                      <td>
                        {r.prmActivity ? (
                          traced.version === version ? (
                            <a href={`#activity-${r.prmActivity}`}>
                              <span class="mono">{r.prmActivity}</span> {activityTitle(r.prmActivity)}
                            </a>
                          ) : (
                            <a href={`${href(locale, traced.version, 'processes', id)}#activity-${r.prmActivity}`}>
                              <span class="mono">{r.prmActivity}</span> {activityTitle(r.prmActivity)} ({traced.version})
                            </a>
                          )
                        ) : (
                          r.note && <span class="muted">{r.note}</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        p.changes?.length ? (
          <section id="changes">
            <h2>
              <span class="sec">{num('changes')}</span>
              {t('process.changes')}
            </h2>
            <p class="muted small">{t('process.changesNote')}</p>
            <ul class="changes">
              {p.changes.map((c) => (
                <li>
                  <div class="change-head">
                    <strong class="mono">{c.annotation}</strong>
                    <span class={`badge decision-${c.decision.replace(/\s+/g, '-')}`}>{decisionLabel(c.decision)}</span>
                    {c.raisedElsewhere && <span class="badge">{t('process.raisedElsewhere')}</span>}
                    {(c.redVotes != null || c.yellowVotes != null) && (
                      <span class="votes small muted">
                        <span class="dot red" /> {c.redVotes ?? 0} {t('process.redVotes')} · <span class="dot yellow" /> {c.yellowVotes ?? 0}{' '}
                        {t('process.yellowVotes')}
                      </span>
                    )}
                  </div>
                  <p class="annotation" set:html={inline(c.text)} />
                  {c.changes.length > 0 && (
                    <ul class="change-list small">
                      {c.changes.map((ch) => (
                        <li>
                          <span class={`kind kind-${ch.kind}`}>{t(`change.${ch.kind}`)}</span>
                          {ch.target && <strong>{ch.target}: </strong>}
                          <span set:html={inline(ch.text)} />
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <nav class="pager title-block no-print">
        {
          prev ? (
            <a href={href(locale, version, 'processes', prev)}>
              <span class="label">← {t('process.previous')}</span>
              <span>
                <span class="mono muted">{prev}</span> {name(prev)}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="next" href={href(locale, version, 'processes', next)}>
              <span class="label">{t('process.next')} →</span>
              <span>
                <span class="mono muted">{next}</span> {name(next)}
              </span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</Layout>

<script>
  // Route a right-angle wire from every input to the process and from the
  // process to every output. The wires share a vertical bus in each gap.
  const flow = document.querySelector<HTMLElement>('.flow');
  const svg = flow?.querySelector<SVGSVGElement>('.wires');
  const core = flow?.querySelector<HTMLElement>('.core-box');
  const NS = 'http://www.w3.org/2000/svg';

  function drawWires() {
    if (!flow || !svg || !core) return;
    svg.querySelectorAll('path.wire').forEach((p) => p.remove());
    if (getComputedStyle(svg).display === 'none') return;
    const box = flow.getBoundingClientRect();
    const c = core.getBoundingClientRect();
    const coreY = c.top + c.height / 2 - box.top;
    const wire = (d: string) => {
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', d);
      path.setAttribute('class', 'wire');
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', 'currentColor');
      path.setAttribute('stroke-width', '1');
      path.setAttribute('marker-end', 'url(#arrow)');
      svg.appendChild(path);
    };
    flow.querySelectorAll<HTMLElement>('.inputs .io-node').forEach((n) => {
      const r = n.getBoundingClientRect();
      const x1 = r.right - box.left;
      const y1 = r.top - box.top + 20;
      const x2 = c.left - box.left;
      const mid = (x1 + x2) / 2;
      wire(`M${x1} ${y1} H${mid} V${coreY} H${x2 - 1}`);
    });
    flow.querySelectorAll<HTMLElement>('.outputs .io-node').forEach((n) => {
      const r = n.getBoundingClientRect();
      const x1 = c.right - box.left;
      const x2 = r.left - box.left;
      const y2 = r.top - box.top + 20;
      const mid = (x1 + x2) / 2;
      wire(`M${x1} ${coreY} H${mid} V${y2} H${x2 - 1}`);
    });
  }

  if (flow) new ResizeObserver(drawWires).observe(flow);
  document.fonts?.ready.then(drawWires);

  const button = document.querySelector<HTMLButtonElement>('.toggle-all');
  const all = [...document.querySelectorAll<HTMLDetailsElement>('.activities details')];
  const sync = () => {
    const anyOpen = all.some((d) => d.open);
    button!.textContent = anyOpen ? button!.dataset.collapse! : button!.dataset.expand!;
  };
  button?.addEventListener('click', () => {
    const open = !all.some((d) => d.open);
    all.forEach((d) => (d.open = open));
    sync();
  });
  all.forEach((d) => d.addEventListener('toggle', sync));
  // Open the activity a link points to, on load and on in-page links.
  const openTarget = () => {
    if (!location.hash) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const details = target?.querySelector('details');
    if (details && !details.open) {
      details.open = true;
      sync();
    }
  };
  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>

<style>
  h1 {
    margin-bottom: 16px;
  }

  .sheet {
    margin: 0 0 8px;
  }

  @media (max-width: 560px) {
    .sheet {
      grid-template-columns: 1fr 1fr;
    }

    .sheet > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .sheet dd {
    margin: 0;
  }

  .sheet dd a + a {
    margin-left: 10px;
  }

  .sec {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--surface);
    background: var(--ink);
    padding: 1px 6px;
    letter-spacing: 0.04em;
    align-self: center;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .toc {
      position: sticky;
      top: 16px;
      align-self: start;
      margin-top: 32px;
    }
  }

  @media (max-width: 999px) {
    .toc {
      display: none;
    }
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--ink);
    font-size: 0.88rem;
  }

  .toc a {
    display: flex;
    gap: 8px;
    padding: 4px 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .toc a .mono {
    font-size: 0.75rem;
    padding-top: 2px;
  }

  .toc a:hover {
    color: var(--text);
  }

  section {
    scroll-margin-top: 16px;
  }

  .purpose {
    font-size: 1.08rem;
  }

  /* Outcomes */
  .outcomes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .outcomes li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    scroll-margin-top: 16px;
  }

  .outcomes li:target {
    background: var(--surface-2);
    outline: 1px dashed var(--ink);
    outline-offset: 4px;
  }

  .letter {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-top: 1px;
  }

  .served {
    margin-top: 6px;
  }

  .served .chip {
    font-size: 0.78rem;
    padding: 0 6px;
  }

  /* Inputs, process and outputs as a diagram */
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px minmax(0, 1fr);
    grid-template-areas: 'in core out';
    gap: 0 32px;
    padding: 20px;
    border: 1px solid var(--ink);
  }

  .flow-col.inputs {
    grid-area: in;
  }

  .flow-col.outputs {
    grid-area: out;
  }

  .flow-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 16px;
  }

  .col-label {
    margin-bottom: -6px;
  }

  .flow-core {
    grid-area: core;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 24px;
  }

  .core-box {
    border: 2px solid var(--ink);
    background: var(--surface);
    padding: 14px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .core-id {
    font-size: 0.8rem;
    background: var(--ink);
    color: var(--surface);
    align-self: center;
    padding: 0 6px;
  }

  .core-name {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .core-outcomes {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--ink);
    overflow: visible;
  }

  .io-node {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--ink);
    padding: 10px 12px;
    scroll-margin-top: 16px;
  }

  .io-node:target {
    box-shadow: var(--lift);
  }

  .io-head {
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: space-between;
  }

  .io-name {
    font-weight: 600;
    color: var(--text);
  }

  .serves {
    display: inline-flex;
    gap: 3px;
    flex: none;
  }

  .serves a {
    font-family: var(--mono);
    font-size: 0.72rem;
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--muted);
  }

  .serves a:hover {
    border-color: var(--ink);
    color: var(--text);
  }

  .io-tags {
    display: flex;
    gap: 4px;
    margin-top: 4px;
  }

  .io-desc {
    margin: 6px 0 8px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .io-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-items: center;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }

