---
import Layout from '../../../../layouts/Layout.astro';
import { getProcess, getVersion, getWorkProducts, processIds, versions, pick } from '../../../../lib/content';
import { processPaths } from '../../../../lib/paths';
import { inline, plain } from '../../../../lib/text';
import { referenceByKey, shortCite, studyById } from '../../../../lib/refs';
import { useTranslations, href, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = processPaths;
const locale = Astro.props.locale as Locale;
const { version, id } = Astro.params as { version: string; id: string };
const t = useTranslations(locale);
const { data: p, translated } = getProcess(version, id, locale);
const v = getVersion(version);

const wps = new Map(getWorkProducts(version, locale).map((w) => [w.id, w]));
const name = (pid: string) => getProcess(version, pid, locale).data.name;

// Traceability lives in the version that was traced against the standards.
const traced = p.standards
  ? { version, rows: p.standards }
  : versions
      .map((x) => x.id)
      .filter((x) => x !== version && processIds(x).includes(id))
      .map((x) => ({ version: x, rows: getProcess(x, id, locale).data.standards }))
      .find((x) => x.rows?.length);
const tracedActivities = traced && traced.version !== version ? getProcess(traced.version, id, locale).data.activities : p.activities;
const activityTitle = (aid?: string) => tracedActivities.find((a) => a.id === aid)?.title;

const ids = processIds(version);
const i = ids.indexOf(id);
const prev = ids[i - 1];
const next = ids[i + 1];

const versionLinks = Object.fromEntries(
  versions.map((x) => [x.id, processIds(x.id).includes(id) ? href(locale, x.id, 'processes', id) : href(locale, x.id)]),
);
const otherVersions = versions.filter((x) => x.id !== version && processIds(x.id).includes(id));
const comparePair = (other: string) => {
  const order = versions.map((x) => x.id);
  return order.indexOf(other) < order.indexOf(version) ? `${other}-vs-${version}` : `${version}-vs-${other}`;
};

// Work products that support each outcome, from the serves lists.
const servedBy = (oid: string) => [
  ...p.inputs.filter((io) => io.serves.includes(oid)).map((io) => ({ ...io, dir: 'in' })),
  ...p.outputs.filter((io) => io.serves.includes(oid)).map((io) => ({ ...io, dir: 'out' })),
];
const wpHref = (wid: string) => `${href(locale, version, 'work-products')}#${wid}`;
---

<Layout locale={locale} title={p.name} description={plain(p.purpose)} section="processes" version={version} versionLinks={versionLinks} translated={translated}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href(locale, version)}>{t('map.title')} {version}</a> / {p.id}
  </nav>

  <header class="process-header">
    <h1><span class="pid">{p.id}</span> {p.name}</h1>
    <div class="header-meta">
      <span class={`badge origin-${p.origin}`} title={t(`origin.${p.origin}.long`)}>{t(`origin.${p.origin}`)}</span>
      <span class="badge">{pick(v.title, locale)}</span>
      {
        otherVersions.map((o) => (
          <a class="small" href={href(locale, 'compare', comparePair(o.id), id)}>
            {t('process.compare', { version: o.id })}
          </a>
        ))
      }
    </div>
  </header>

  <div class="layout">
    <aside class="toc no-print" aria-label="Contents">
      <ol>
        <li><a href="#purpose">{t('process.purpose')}</a></li>
        <li><a href="#outcomes">{t('process.outcomes')}</a></li>
        <li><a href="#inputs">{t('process.inputs')}</a></li>
        <li><a href="#outputs">{t('process.outputs')}</a></li>
        <li><a href="#activities">{t('process.activities')}</a></li>
        {traced && <li><a href="#standards">{t('process.standards')}</a></li>}
        {p.changes?.length ? <li><a href="#changes">{t('process.changes')}</a></li> : null}
      </ol>
    </aside>

    <article class="content">
      <section id="purpose">
        <h2>{t('process.purpose')}</h2>
        <p class="prose purpose" set:html={inline(p.purpose)} />
      </section>

      <section id="outcomes">
        <h2>{t('process.outcomes')}</h2>
        <ol class="outcomes">
          {
            p.outcomes.map((o) => (
              <li id={`outcome-${o.id}`}>
                <span class="letter">({o.id})</span>
                <div>
                  <span set:html={inline(o.text)} />
                  {servedBy(o.id).length > 0 && (
                    <div class="chips served" aria-label={t('process.outcomeServedBy')}>
                      {servedBy(o.id).map((io) => (
                        <a class="chip" href={`#${io.dir === 'in' ? 'input' : 'output'}-${io.workProduct}`}>
                          <span aria-hidden="true">{io.dir === 'in' ? '→' : '←'}</span>
                          {io.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      {
        (['inputs', 'outputs'] as const).map((kind) => (
          <section id={kind}>
            <h2>{t(`process.${kind}`)}</h2>
            <ul class="io">
              {p[kind].map((io) => {
                const wp = wps.get(io.workProduct);
                const links = kind === 'inputs' ? wp?.producers : wp?.consumers.filter((c) => c.process !== id);
                return (
                  <li id={`${kind === 'inputs' ? 'input' : 'output'}-${io.workProduct}`} class="card">
                    <div class="io-head">
                      <a class="io-name" href={wpHref(io.workProduct)}>{io.name}</a>
                      {io.optional && <span class="badge">{t('process.optional')}</span>}
                      {wp && <span class="badge">{t(`wp.type.${wp.type}`)}</span>}
                      {io.serves.length > 0 && (
                        <span class="serves" title={t('process.serves')}>
                          {io.serves.map((s) => (
                            <a href={`#outcome-${s}`}>({s})</a>
                          ))}
                        </span>
                      )}
                    </div>
                    {io.description && <p class="io-desc" set:html={inline(io.description)} />}
                    <div class="io-links">
                      <span class="muted small">{kind === 'inputs' ? t('process.producedBy') : t('process.usedBy')}:</span>
                      {links && links.length > 0 ? (
                        <span class="chips">
                          {links.map((l) => (
                            <a class="chip" href={href(locale, version, 'processes', l.process)}>
                              <span class="num">{l.process}</span>
                              {name(l.process)}
                            </a>
                          ))}
                        </span>
                      ) : (
                        <span class="muted small">{kind === 'inputs' ? t('process.external') : t('process.notUsed')}</span>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }

      <section id="activities">
        <div class="section-head">
          <h2>{t('process.activities')}</h2>
          <button type="button" class="toggle-all no-print" data-expand={t('process.expandAll')} data-collapse={t('process.collapseAll')}>
            {t('process.collapseAll')}
          </button>
        </div>
        <ol class="activities">
          {
            p.activities.map((a) => (
              <li id={`activity-${a.id}`}>
                <details open>
                  <summary>
                    <span class="aid">{a.id}</span>
                    <span set:html={inline(a.title)} />
                  </summary>
                  <p class="prose" set:html={inline(a.description)} />
                  {(a.primaryStudies?.length || a.literature?.length) && (
                    <dl class="sources small">
                      {a.primaryStudies?.length ? (
                        <>
                          <dt>{t('process.primaryStudies')}</dt>
                          <dd class="chips">
                            {a.primaryStudies.map((s) => (
                              <a class="chip" href={`${href(locale, 'references')}#${s}`} title={studyById.get(s)?.title}>
                                {s}
                              </a>
                            ))}
                          </dd>
                        </>
                      ) : null}
                      {a.literature?.length ? (
                        <>
                          <dt>{t('process.literature')}</dt>
                          <dd class="chips">
                            {a.literature.map((k) => (
                              <a class="chip" href={`${href(locale, 'references')}#${k}`} title={referenceByKey.get(k)?.title}>
                                {shortCite(referenceByKey.get(k), k)}
                              </a>
                            ))}
                          </dd>
                        </>
                      ) : null}
                    </dl>
                  )}
                </details>
              </li>
            ))
          }
        </ol>
      </section>

      {
        traced && (
          <section id="standards">
            <h2>{t('process.standards')}</h2>
            <p class="muted small">
              {t('process.standardsNote')} {traced.version !== version && t('process.standardsV1', { version: traced.version })}
            </p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{t('process.standard')}</th>
                    <th>{t('process.standardActivity')}</th>
                    <th>{t('process.prmActivity')}</th>
                  </tr>
                </thead>
                <tbody>
                  {traced.rows!.map((r) => (
                    <tr>
                      <td class="nowrap">
                        {r.standard}
                        {r.standardProcess && <div class="muted small">{r.standardProcess}</div>}
                      </td>
                      <td>{r.activity || <span class="muted">{t('process.noStandardActivity')}</span>}</td>
                      <td>
                        {r.prmActivity ? (
                          traced.version === version ? (
                            <a href={`#activity-${r.prmActivity}`}>
                              {r.prmActivity}. {activityTitle(r.prmActivity)}
                            </a>
                          ) : (
                            <a href={`${href(locale, traced.version, 'processes', id)}#activity-${r.prmActivity}`}>
                              {r.prmActivity}. {activityTitle(r.prmActivity)} ({traced.version})
                            </a>
                          )
                        ) : (
                          r.note && <span class="muted">{r.note}</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        p.changes?.length ? (
          <section id="changes">
            <h2>{t('process.changes')}</h2>
            <p class="muted small">{t('process.changesNote')}</p>
            <ul class="changes">
              {p.changes.map((c) => (
                <li class="card">
                  <div class="change-head">
                    <strong>{c.annotation}</strong>
                    <span class={`badge decision-${c.decision.replace(/\s+/g, '-')}`}>{t(`decision.${c.decision}` as any) ?? c.decision}</span>
                    {c.raisedElsewhere && <span class="badge">{t('process.raisedElsewhere')}</span>}
                    {(c.redVotes != null || c.yellowVotes != null) && (
                      <span class="votes small muted">
                        {t('process.votes')}: <span class="dot red" /> {c.redVotes ?? 0} {t('process.redVotes')} · <span class="dot yellow" /> {c.yellowVotes ?? 0}{' '}
                        {t('process.yellowVotes')}
                      </span>
                    )}
                  </div>
                  <p class="annotation" set:html={inline(c.text)} />
                  {c.changes.length > 0 && (
                    <ul class="change-list small">
                      {c.changes.map((ch) => (
                        <li>
                          <span class={`kind kind-${ch.kind}`}>{t(`change.${ch.kind}`)}</span>
                          {ch.target && <strong>{ch.target}: </strong>}
                          <span set:html={inline(ch.text)} />
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <nav class="pager no-print">
        {
          prev ? (
            <a class="card" href={href(locale, version, 'processes', prev)}>
              <span class="muted small">← {t('process.previous')}</span>
              <span>
                <span class="num">{prev}</span> {name(prev)}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="card next" href={href(locale, version, 'processes', next)}>
              <span class="muted small">{t('process.next')} →</span>
              <span>
                <span class="num">{next}</span> {name(next)}
              </span>
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('.toggle-all');
  const all = [...document.querySelectorAll<HTMLDetailsElement>('.activities details')];
  const sync = () => {
    const anyOpen = all.some((d) => d.open);
    button!.textContent = anyOpen ? button!.dataset.collapse! : button!.dataset.expand!;
  };
  button?.addEventListener('click', () => {
    const open = !all.some((d) => d.open);
    all.forEach((d) => (d.open = open));
    sync();
  });
  all.forEach((d) => d.addEventListener('toggle', sync));
  // Open the activity a link points to.
  const target = location.hash && document.querySelector(location.hash);
  if (target instanceof HTMLElement) target.querySelector('details')?.setAttribute('open', '');
</script>

<style>
  .process-header h1 {
    margin-bottom: 8px;
  }

  .pid {
    font-family: var(--mono);
    font-size: 0.7em;
    color: var(--muted);
    font-weight: 500;
    vertical-align: 0.12em;
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 190px minmax(0, 1fr);
    }

    .toc {
      position: sticky;
      top: 16px;
      align-self: start;
      margin-top: 28px;
    }
  }

  @media (max-width: 959px) {
    .toc {
      display: none;
    }
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--border);
    font-size: 0.9rem;
  }

  .toc a {
    display: block;
    padding: 4px 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
  }

  .purpose {
    font-size: 1.05rem;
  }

  .outcomes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .outcomes li {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    scroll-margin-top: 16px;
  }

  .outcomes li:target {
    background: var(--surface-2);
    border-radius: 8px;
  }

  .letter {
    font-family: var(--mono);
    color: var(--muted);
  }

  .served {
    margin-top: 4px;
  }

  .served .chip {
    font-size: 0.78rem;
    padding: 0 7px;
  }

  .io {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .io li {
    scroll-margin-top: 16px;
  }

  .io li:target {
    border-color: var(--accent);
  }

  .io-head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: baseline;
  }

  .io-name {
    font-weight: 650;
  }

  .serves {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.85rem;
    display: inline-flex;
    gap: 4px;
  }

  .io-desc {
    margin: 4px 0 8px;
    color: var(--muted);
  }

  .io-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: center;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .toggle-all {
    font-size: 0.85rem;
    padding: 3px 10px;
  }

  .activities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }

  .activities li {
    scroll-margin-top: 16px;
  }

  .activities details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 10px 16px;
  }

  .activities li:target details {
    border-color: var(--accent);
  }

  .activities summary {
    cursor: pointer;
    font-weight: 600;
    display: flex;
    gap: 10px;
    list-style-position: outside;
  }

  .activities summary::-webkit-details-marker {
    display: none;
  }

  .aid {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent-strong);
    padding-top: 2px;
    min-width: 2em;
  }

  .activities details > p {
    margin: 8px 0 4px;
  }

  .sources {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    margin: 10px 0 0;
    align-items: center;
  }

  .sources dt {
    color: var(--muted);
  }

  .sources dd {
    margin: 0;
  }

  @media (max-width: 560px) {
    .sources {
      grid-template-columns: 1fr;
    }
  }

  .nowrap {
    white-space: nowrap;
  }

  .changes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .change-head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
  }

  .votes {
    margin-left: auto;
  }

  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot.red {
    background: #d9534f;
  }

  .dot.yellow {
    background: #f0c419;
  }

  .decision-adopted {
    background: var(--ins-bg);
    color: var(--ins-text);
    border-color: transparent;
  }

  .decision-rejected {
    background: var(--del-bg);
    color: var(--del-text);
    border-color: transparent;
  }

  .annotation {
    font-style: italic;
  }

  .change-list {
    margin: 6px 0 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .kind {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-right: 6px;
    padding: 0 6px;
    border-radius: 4px;
    background: var(--surface-2);
  }

  .kind-added {
    background: var(--ins-bg);
    color: var(--ins-text);
  }

  .kind-removed {
    background: var(--del-bg);
    color: var(--del-text);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
  }

  .pager .next {
    text-align: right;
  }

  .pager .num {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
