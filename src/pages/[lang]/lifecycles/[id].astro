---
import Layout from '../../../layouts/Layout.astro';
import LifecyclePhases from '../../../components/LifecyclePhases.astro';
import { getLifecycle, getProcess, processIds } from '../../../lib/content';
import { lifecyclePaths } from '../../../lib/paths';
import { inline } from '../../../lib/text';
import { useTranslations, href, type Locale } from '../../../i18n/ui';

export const getStaticPaths = lifecyclePaths;
const locale = Astro.props.locale as Locale;
const { id } = Astro.params as { id: string };
const t = useTranslations(locale);
const { data: l, translated } = getLifecycle(id, locale);
const included = new Set(l.phases.flatMap((p) => p.processes));
const missing = processIds(l.prmVersion).filter((pid) => !included.has(pid));
---

<Layout locale={locale} title={l.name} section="lifecycles" translated={translated}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href(locale, 'lifecycles')}>{t('lc.title')}</a> / {l.name}
  </nav>
  <h1>{l.name}</h1>
  <div class="meta">
    {l.status === 'draft' && <span class="badge">{t('lc.draft')}</span>}
    <a class="badge" href={href(locale, l.prmVersion)}>{t('lc.basedOn', { version: l.prmVersion })}</a>
    {l.source && <span class="small muted">{t('lc.source')}: {l.source}</span>}
  </div>
  {l.description && <p class="prose" set:html={inline(l.description)} />}

  <LifecyclePhases locale={locale} lifecycle={l} />

  {
    missing.length > 0 && (
      <section>
        <h2>{t('lc.notCovered')}</h2>
        <div class="chips">
          {missing.map((pid) => (
            <a class="chip" href={href(locale, l.prmVersion, 'processes', pid)}>
              <span class="num">{pid}</span>
              {getProcess(l.prmVersion, pid, locale).data.name}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <p class="no-print"><a class="button primary" href={`${href(locale, 'tailor')}#v=${l.prmVersion}&lc=${l.id}`}>{t('lc.useInTailor')} →</a></p>
</Layout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
  }

  a.badge {
    text-decoration: none;
  }

  section {
    margin-bottom: 24px;
  }
</style>
