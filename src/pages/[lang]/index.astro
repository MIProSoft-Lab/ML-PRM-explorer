---
import Layout from '../../layouts/Layout.astro';
import { site, pick, versions, defaultVersion, processIds } from '../../lib/content';
import { localePaths } from '../../lib/paths';
import { edition, otherEditionUrl } from '../../lib/edition';
import { inline } from '../../lib/text';
import { useTranslations, href, type Locale } from '../../i18n/ui';

export const getStaticPaths = localePaths;
const locale = Astro.props.locale as Locale;
const t = useTranslations(locale);
const { thesis, group, people, timeline } = site;

const cards = [
  ['nav.processes', 'home.card-map', href(locale, defaultVersion)],
  ['nav.workProducts', 'home.card-flow', href(locale, defaultVersion, 'work-products')],
  ['nav.compare', 'home.card-compare', href(locale, 'compare')],
  ['nav.lifecycles', 'home.card-lifecycles', href(locale, 'lifecycles')],
  ['nav.tailor', 'home.card-tailor', href(locale, 'tailor')],
  ['nav.references', 'home.card-references', href(locale, 'references')],
] as const;

const uses = [
  ['home.use-practitioners', 'home.use-practitioners-text', href(locale, 'tailor'), 'nav.tailor'],
  ['home.use-researchers', 'home.use-researchers-text', href(locale, 'compare'), 'nav.compare'],
  ['home.use-standards', 'home.use-standards-text', href(locale, defaultVersion), 'nav.processes'],
] as const;

// The citation of the thesis, as text and as BibTeX. The surname is everything
// after the first given name, as in "Crespí Tobeña".
const [given, ...surnames] = site.author.split(' ');
const surname = surnames.join(' ');
const citation = thesis && `${surname}, ${given[0]}. (${thesis.year}). *${thesis.title}* [Doctoral thesis, ${site.institution}].`;
const bibtex =
  thesis &&
  `@phdthesis{${surname.split(' ')[0].normalize('NFD').replace(/[^a-zA-Z]/g, '').toLowerCase()}${thesis.year}prm,
  author = {${surname}, ${given}},
  title  = {${thesis.title}},
  school = {${site.institution}},
  year   = {${thesis.year}}
}`;

// The thesis edition, linked from the live site when both are published.
const thesisEdition = edition === 'live' && otherEditionUrl ? `${otherEditionUrl}${locale}/` : undefined;
---

<Layout locale={locale}>
  <section class="hero">
    <p class="breadcrumbs">ML-PRM · {t('footer.thesis')} · {site.institution}</p>
    <h1>{pick(site.title, locale)}</h1>
    <p class="lead prose">{pick(site.intro, locale)}</p>
    <p class="actions">
      <a class="button primary" href={href(locale, defaultVersion)}>{t('home.explore')} →</a>
      <a class="button" href={href(locale, 'tailor')}>{t('nav.tailor')}</a>
    </p>
  </section>

  {
    thesis && (
      <section class="block" aria-labelledby="thesis">
        <h2 id="thesis">{t('home.thesisHeading')}</h2>
        <p class="prose" set:html={inline(t('home.thesisText', { title: thesis.title }))} />
        <dl class="titleblock">
          <div>
            <dt class="label">{t('home.author')}</dt>
            <dd>{site.author}</dd>
          </div>
          {thesis.supervisors.length > 0 && (
            <div>
              <dt class="label">{t(thesis.supervisors.length > 1 ? 'home.supervisors' : 'home.supervisor')}</dt>
              <dd>{thesis.supervisors.join(', ')}</dd>
            </div>
          )}
          {site.institution && (
            <div>
              <dt class="label">{t('footer.institution')}</dt>
              <dd>{site.institution}</dd>
            </div>
          )}
          <div>
            <dt class="label">{t('home.year')}</dt>
            <dd class="mono">{thesis.year}</dd>
          </div>
        </dl>
        {
          thesisEdition && (
            <p>
              <a href={thesisEdition}>{t('edition.thesisLink')} →</a>
            </p>
          )
        }

        {timeline.length > 0 && (
          <>
            <h3 class="sub">{t('home.originHeading')}</h3>
            <ol class="timeline">
              {timeline.map((step, i) => (
                <li>
                  <span class="step mono">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <strong>{pick(step.title, locale)}</strong>
                    <p class="muted small">{pick(step.text, locale)}</p>
                  </div>
                </li>
              ))}
            </ol>
          </>
        )}

        <div class="cite">
          <div class="cite-head">
            <span class="label">{t('home.cite')}</span>
            <button type="button" class="copy" data-copy={bibtex} data-copied={t('home.copied')}>
              {t('home.copy')} BibTeX
            </button>
          </div>
          <p class="small muted">{t('home.citeText')}</p>
          <p class="small" set:html={inline(citation!)} />
          <pre class="mono small">{bibtex}</pre>
        </div>
      </section>
    )
  }

  {
    group && (
      <section class="block" aria-labelledby="group">
        <h2 id="group">{t('home.groupHeading')}</h2>
        <div class="group">
          <div>
            <p class="group-name">
              <span class="brand-code">{group.name}</span>
              <strong>{pick(group.fullName, locale)}</strong>
            </p>
            <p class="prose">{pick(group.description, locale)}</p>
            {group.researchLines.length > 0 && (
              <>
                <h3 class="label">{t('home.researchLines')}</h3>
                <ul class="lines">
                  {group.researchLines.map((line) => (
                    <li>{pick(line, locale)}</li>
                  ))}
                </ul>
              </>
            )}
            {group.url && (
              <p>
                <a href={pick(group.url, locale)}>{t('home.groupLink')} →</a>
              </p>
            )}
          </div>
          {people.length > 0 && (
            <div>
              <h3 class="label">{t('home.people')}</h3>
              <ul class="people">
                {people.map((p) => (
                  <li>
                    {p.url ? <a href={p.url}>{p.name}</a> : <strong>{p.name}</strong>}
                    <span class="muted small">{pick(p.role, locale)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="overview">
    <h2 id="overview">{t('home.overview')}</h2>
    <ol class="sheets">
      {
        cards.map(([title, text, url], i) => (
          <li>
            <a class="sheet" href={url}>
              <span class="sheet-head">
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                <strong>{t(title)}</strong>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="sheet-body muted">{t(text)}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="block" aria-labelledby="uses">
    <h2 id="uses">{t('home.useHeading')}</h2>
    <ul class="uses">
      {
        uses.map(([title, text, url, link]) => (
          <li>
            <h3>{t(title)}</h3>
            <p class="muted">{t(text)}</p>
            <a href={url}>{t(link)} →</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block" aria-labelledby="versions">
    <h2 id="versions">{t('home.versions')}</h2>
    <div class="table-wrap">
      <table class="revisions">
        <tbody>
          {
            [...versions].reverse().map((v) => (
              <tr>
                <td class="rev">
                  <a class="mono" href={href(locale, v.id)}>
                    {v.id}
                  </a>
                </td>
                <td>
                  <a href={href(locale, v.id)}>{pick(v.title, locale)}</a>
                  <div class="muted small">{pick(v.description, locale)}</div>
                </td>
                <td class="mono small nowrap">
                  {processIds(v.id).length} {t('home.processes')}
                </td>
                <td>
                  <span class="badge">{t(`home.${v.status}`)}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  // Copy the BibTeX of the thesis, and say so on the button for a moment.
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = button.dataset.copied!;
        setTimeout(() => (button.textContent = label), 1500);
      } catch {}
    });
  });
</script>

<style>
  .hero {
    padding: 8px 0 16px;
    max-width: 860px;
  }

  .hero h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem);
    letter-spacing: -0.02em;
    margin: 0.2em 0 0.4em;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .block {
    margin-top: 48px;
  }

  .sub {
    margin: 32px 0 12px;
    font-size: 1.05rem;
  }

  /* Title block of a drawing: label above value, cells side by side. */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    margin: 20px 0;
    border: 1px solid var(--ink);
    background: var(--surface);
  }

  .titleblock > div {
    padding: 8px 12px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .titleblock dd {
    margin: 2px 0 0;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    border: 1px solid var(--ink);
    background: var(--surface);
  }

  .timeline li {
    display: flex;
    gap: 10px;
    padding: 12px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .timeline .step {
    align-self: flex-start;
    font-size: 0.75rem;
    padding: 0 6px;
    background: var(--ink-fill);
    color: var(--surface);
  }

  .timeline p {
    margin: 4px 0 0;
  }

  .cite {
    margin-top: 24px;
    padding: 12px 16px;
    border: 1px dashed var(--ink);
    background: var(--surface);
  }

  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cite p {
    margin: 8px 0;
  }

  .cite pre {
    margin: 0;
    padding: 10px 12px;
    overflow-x: auto;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .copy {
    font-size: 0.8rem;
    padding: 2px 10px;
  }

  .group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 32px;
  }

  @media (max-width: 760px) {
    .group {
      grid-template-columns: 1fr;
    }
  }

  .group-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 0;
  }

  .group-name .brand-code {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 3px 7px;
    background: var(--ink-fill);
    color: var(--surface);
  }

  .lines {
    margin: 6px 0 16px;
    padding-left: 1.2em;
  }

  .people {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    border-top: 1px solid var(--ink);
  }

  .people li {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }

  .sheets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .sheet {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--ink);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease;
  }

  .sheet:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--lift);
  }

  .sheet-head {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 8px 12px;
    border-bottom: 1px solid var(--ink);
  }

  .sheet-head .mono {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .arrow {
    margin-left: auto;
    font-family: var(--mono);
  }

  .sheet-body {
    padding: 10px 12px 14px;
    font-size: 0.93rem;
  }

  .uses {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px;
  }

  .uses h3 {
    margin: 0 0 6px;
    font-size: 1rem;
  }

  .uses p {
    margin: 0 0 8px;
  }

  .revisions td {
    vertical-align: middle;
  }

  .rev {
    width: 4em;
    font-size: 1rem;
  }

  .nowrap {
    white-space: nowrap;
  }
</style>
