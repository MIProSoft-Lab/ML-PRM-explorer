---
import Layout from '../layouts/Layout.astro';
import { defaultLocale, href, useTranslations } from '../i18n/ui';

const t = useTranslations(defaultLocale);
---

<Layout locale={defaultLocale} title={t('notFound.title')}>
  <h1>{t('notFound.title')}</h1>
  <p><a href={href(defaultLocale)}>{t('notFound.back')}</a></p>
</Layout>
