---
// Diagram of a lifecycle model, drawn by src/lib/lifecycle-diagram.ts, with
// zoom, panning and hover information. Without a lifecycle it renders an empty
// frame that a page script fills in and announces with an "lc-diagram:update"
// event, as the tailoring page does.
import { getProcess, type Lifecycle } from '../lib/content';
import { diagramSvgs, lifecycleLoops } from '../lib/lifecycle-diagram';
import { useTranslations, href, type Locale } from '../i18n/ui';
import { plain } from '../lib/text';

interface Props {
  locale: Locale;
  lifecycle?: Lifecycle;
}

const { locale, lifecycle: l } = Astro.props;
const t = useTranslations(locale);

const svgs = l
  ? diagramSvgs(
      {
        name: l.name,
        version: l.prmVersion,
        procHref: (pid) => href(locale, l.prmVersion, 'processes', pid),
        phases: l.phases.map((ph) => ({
          ...ph,
          description: ph.description && plain(ph.description),
          procs: ph.processes.map((pid) => {
            const p = getProcess(l.prmVersion, pid, locale).data;
            return { id: pid, name: p.name, origin: p.origin, purpose: plain(p.purpose) };
          }),
        })),
      },
      t as (key: string, vars?: Record<string, string | number>) => string,
    )
  : '';
const loops = l ? lifecycleLoops(l.phases) : [];
const loopText = (loop: (typeof loops)[number]) => `${l!.phases[loop.from].name} → ${l!.phases[loop.to].name}`;
---

<figure class="lc-diagram grid-paper">
  <div class="tools no-print">
    <span class="hint small muted">{t('lc.zoomHint')}</span>
    <div class="pills" role="group" aria-label={t('lc.zoom')}>
      <button type="button" data-zoom="out" aria-label={t('lc.zoomOut')} title={t('lc.zoomOut')}>−</button>
      <button type="button" data-zoom="fit" aria-label={t('lc.zoomFit')} title={t('lc.zoomFit')}><span class="level">100%</span></button>
      <button type="button" data-zoom="in" aria-label={t('lc.zoomIn')} title={t('lc.zoomIn')}>+</button>
    </div>
  </div>
  <div class="viewport" tabindex="0" aria-label={t('lc.zoomHint')} set:html={svgs} />
  <div class="tip" role="tooltip" hidden>
    <strong class="tip-title"></strong>
    <span class="tip-meta label"></span>
    <span class="tip-body"></span>
  </div>

  <figcaption class="legend-list small">
    <span><span class="key key-next" aria-hidden="true">→</span>{t('lc.legendNext')}</span>
    <span><span class="key" aria-hidden="true">↻</span>{t('lc.legendRepeated')}</span>
    <span><span class="key key-loop" aria-hidden="true">L1</span>{t('lc.legendLoop')}</span>
  </figcaption>
</figure>

{
  loops.length > 0 && (
    <section class="lc-loops">
      <h2>{t('lc.loops')}</h2>
      <ol>
        {loops.map((loop) => (
          <li>
            <span class="loop-id mono">{loop.label}</span>
            <div>
              <strong>{loopText(loop)}</strong>
              {loop.note && <p class="muted small">{loop.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}

<script>
  // Zooming and moving around the diagram, and the hover information.
  // Zoom changes the viewBox of the visible drawing, so text stays sharp.
  const MIN = 1;
  const MAX = 4;
  const clamp = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x));

  interface View {
    W: number;
    H: number;
    x: number;
    y: number;
    k: number;
  }

  function init(fig: HTMLElement) {
    const viewport = fig.querySelector<HTMLElement>('.viewport')!;
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const level = fig.querySelector<HTMLElement>('.level')!;
    // The drawings are looked up on use, since a page may redraw them.
    const svgs = () => [...fig.querySelectorAll<SVGSVGElement>('svg.diagram')];
    const views = new WeakMap<SVGSVGElement, View>();
    const view = (svg: SVGSVGElement) => {
      if (!views.has(svg)) {
        const [W, H] = svg.dataset.size!.split(' ').map(Number);
        views.set(svg, { W, H, x: 0, y: 0, k: 1 });
      }
      return views.get(svg)!;
    };
    // Both drawings are in the page; the stylesheet shows one of them.
    const active = () => svgs().find((svg) => svg.getBoundingClientRect().width > 0) ?? svgs()[0];

    function apply(svg: SVGSVGElement | undefined) {
      if (!svg) return;
      const v = view(svg);
      const w = v.W / v.k;
      const h = v.H / v.k;
      v.x = clamp(v.x, 0, v.W - w);
      v.y = clamp(v.y, 0, v.H - h);
      svg.setAttribute('viewBox', `${v.x} ${v.y} ${w} ${h}`);
      if (svg === active()) {
        viewport.classList.toggle('zoomed', v.k > 1.001);
        level.textContent = `${Math.round(v.k * 100)}%`;
      }
    }

    /** Zoom by a factor around a point given in client coordinates (the centre by default). */
    function zoomAt(factor: number, cx?: number, cy?: number) {
      const svg = active();
      if (!svg) return;
      const v = view(svg);
      const r = svg.getBoundingClientRect();
      const fx = cx === undefined ? 0.5 : (cx - r.left) / r.width;
      const fy = cy === undefined ? 0.5 : (cy - r.top) / r.height;
      const px = v.x + (fx * v.W) / v.k;
      const py = v.y + (fy * v.H) / v.k;
      v.k = clamp(v.k * factor, MIN, MAX);
      v.x = px - (fx * v.W) / v.k;
      v.y = py - (fy * v.H) / v.k;
      apply(svg);
    }

    function panBy(dx: number, dy: number) {
      const svg = active();
      if (!svg) return;
      const v = view(svg);
      const r = svg.getBoundingClientRect();
      v.x -= (dx / r.width) * (v.W / v.k);
      v.y -= (dy / r.height) * (v.H / v.k);
      apply(svg);
    }

    function fit() {
      const svg = active();
      if (!svg) return;
      Object.assign(view(svg), { x: 0, y: 0, k: 1 });
      apply(svg);
    }

    const zoomed = () => {
      const svg = active();
      return !!svg && view(svg).k > 1.001;
    };

    fig.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.zoom === 'in') zoomAt(1.25);
        if (b.dataset.zoom === 'out') zoomAt(0.8);
        if (b.dataset.zoom === 'fit') fit();
      }),
    );

    // Ctrl + wheel, which is also what a trackpad pinch sends. A plain wheel
    // keeps scrolling the page.
    viewport.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        // A trackpad pinch sends many small steps, a mouse wheel few large
        // ones (about 100 per notch, or lines). Scale both to a gentle zoom.
        const pinch = e.deltaMode === 0 && Math.abs(e.deltaY) < 50;
        const delta = e.deltaMode === 1 ? e.deltaY * 33 : e.deltaY;
        zoomAt(Math.exp(-delta * (pinch ? 0.01 : 0.002)), e.clientX, e.clientY);
      },
      { passive: false },
    );

    viewport.addEventListener('keydown', (e) => {
      const step = 40;
      const keys: Record<string, () => void> = {
        '+': () => zoomAt(1.25),
        '=': () => zoomAt(1.25),
        '-': () => zoomAt(0.8),
        '0': fit,
        ArrowLeft: () => panBy(step, 0),
        ArrowRight: () => panBy(-step, 0),
        ArrowUp: () => panBy(0, step),
        ArrowDown: () => panBy(0, -step),
      };
      const action = keys[e.key];
      if (!action || (e.key.startsWith('Arrow') && !zoomed())) return;
      e.preventDefault();
      action();
    });

    // Drag to move when zoomed, and pinch with two fingers.
    const pointers = new Map<number, { x: number; y: number }>();
    let dragging = false;
    let moved = 0;
    let suppressClick = false;

    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      moved = 0;
    });

    viewport.addEventListener('pointermove', (e) => {
      const last = pointers.get(e.pointerId);
      if (!last) return;
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const other = a === last ? b : a;
        const before = Math.hypot(last.x - other.x, last.y - other.y);
        const after = Math.hypot(e.clientX - other.x, e.clientY - other.y);
        if (before > 0) zoomAt(after / before, (e.clientX + other.x) / 2, (e.clientY + other.y) / 2);
        dragging = true;
      } else if (zoomed()) {
        moved += Math.abs(e.clientX - last.x) + Math.abs(e.clientY - last.y);
        if (moved > 4 && !dragging) {
          dragging = true;
          viewport.setPointerCapture(e.pointerId);
          viewport.classList.add('dragging');
          hideTip();
        }
        if (dragging) panBy(e.clientX - last.x, e.clientY - last.y);
      }
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    });

    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size === 0 && dragging) {
        dragging = false;
        suppressClick = true;
        viewport.classList.remove('dragging');
        setTimeout(() => (suppressClick = false));
      }
    };
    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);

    // A drag that ends over a process must not open it.
    viewport.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    // --- Hover information ----------------------------------------------

    let current: Element | null = null;

    function highlight(el: Element | null) {
      fig.querySelectorAll('.hl').forEach((x) => x.classList.remove('hl'));
      if (!el) return;
      const svg = el.closest('svg')!;
      const phase = (i: string | null) => svg.querySelector(`.phase[data-phase="${i}"]`);
      el.classList.add('hl');
      if (el.matches('.loop')) {
        phase(el.getAttribute('data-from'))?.classList.add('hl');
        phase(el.getAttribute('data-to'))?.classList.add('hl');
      } else if (el.matches('.phase')) {
        const i = el.getAttribute('data-phase');
        svg.querySelectorAll(`.loop[data-from="${i}"], .loop[data-to="${i}"]`).forEach((x) => x.classList.add('hl'));
      } else if (el.matches('.repeat')) {
        el.closest('.phase')?.classList.add('hl');
      }
    }

    function showTip(el: Element) {
      if (el === current) return;
      current = el;
      tip.querySelector('.tip-title')!.textContent = el.getAttribute('data-tip-title');
      tip.querySelector('.tip-meta')!.textContent = el.getAttribute('data-tip-meta') ?? '';
      tip.querySelector('.tip-body')!.textContent = el.getAttribute('data-tip-body') ?? '';
      tip.hidden = false;
      highlight(el.matches('.tag') ? null : el);
    }

    function hideTip() {
      current = null;
      tip.hidden = true;
      highlight(null);
    }

    /** Place the tooltip next to a point, inside the window. */
    function placeTip(x: number, y: number) {
      const r = tip.getBoundingClientRect();
      const left = x + 14 + r.width > innerWidth - 8 ? x - 14 - r.width : x + 14;
      const top = y + 16 + r.height > innerHeight - 8 ? y - 12 - r.height : y + 16;
      tip.style.left = `${clamp(left, 8, innerWidth - r.width - 8)}px`;
      tip.style.top = `${clamp(top, 8, innerHeight - r.height - 8)}px`;
    }

    const tipTarget = (t: EventTarget | null) => (t instanceof Element ? t.closest('[data-tip-title]') : null);

    viewport.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      if (dragging) return;
      const el = tipTarget(e.target);
      if (!el) return hideTip();
      showTip(el);
      placeTip(e.clientX, e.clientY);
    });
    viewport.addEventListener('pointerleave', hideTip);

    // Touch has no hover: a tap on a phase or a loop shows its information.
    viewport.addEventListener('click', (e) => {
      const el = tipTarget(e.target);
      if (!el || el.matches('.tag')) return;
      if (el === current && (e as PointerEvent).pointerType !== 'mouse') return hideTip();
      current = null;
      showTip(el);
      placeTip(e.clientX, e.clientY);
    });
    document.addEventListener('pointerdown', (e) => {
      if (!viewport.contains(e.target as Node)) hideTip();
    });

    // Keyboard focus on a process shows its information below it.
    viewport.addEventListener('focusin', (e) => {
      const el = tipTarget(e.target);
      if (!el) return;
      showTip(el);
      const r = el.getBoundingClientRect();
      placeTip(r.left, r.bottom - 8);
    });
    viewport.addEventListener('focusout', hideTip);
    addEventListener('scroll', hideTip, { passive: true });

    // Switching between the wide and the narrow drawing shows the other one's zoom.
    matchMedia('(max-width: 860px)').addEventListener('change', () => apply(active()));
    // A redrawn diagram starts at full view.
    fig.addEventListener('lc-diagram:update', () => {
      hideTip();
      viewport.classList.remove('zoomed');
      level.textContent = '100%';
    });
  }

  document.querySelectorAll<HTMLElement>('.lc-diagram').forEach(init);
</script>

<style>
  .lc-diagram {
    margin: 20px 0 8px;
    padding: 0 16px 16px;
    border: 1px solid var(--ink);
    position: relative;
  }

  .tools {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    margin: 0 -16px 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .tools .pills button {
    min-width: 30px;
    font-size: 0.85rem;
  }

  .tools .level {
    display: inline-block;
    min-width: 4ch;
    font-size: 0.75rem;
  }

  .viewport {
    overflow: hidden;
    touch-action: pan-y;
    outline-offset: 4px;
  }

  .viewport.zoomed {
    cursor: grab;
    touch-action: none;
  }

  .viewport.dragging {
    cursor: grabbing;
  }

  .viewport.dragging * {
    cursor: grabbing !important;
  }

  .lc-diagram :global(.diagram) {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font);
  }

  .lc-diagram :global(.diagram-v) {
    display: none;
    max-width: 420px;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .lc-diagram :global(.diagram-h) {
      display: none;
    }

    .lc-diagram :global(.diagram-v) {
      display: block;
    }

    .lc-diagram {
      padding: 0 8px 12px;
    }

    .tools {
      margin: 0 -8px 12px;
    }

    .hint {
      display: none;
    }
  }

  .lc-diagram :global(.wire) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .lc-diagram :global(.loop-wire) {
    stroke-dasharray: 5 3;
  }

  /* Wide invisible strokes make the thin lines easy to point at. */
  .lc-diagram :global(.hit) {
    fill: none;
    stroke: transparent;
    stroke-width: 14;
    pointer-events: stroke;
  }

  .lc-diagram :global(.loop),
  .lc-diagram :global(.repeat),
  .lc-diagram :global(.phase) {
    cursor: help;
  }

  .lc-diagram :global(.tag) {
    cursor: pointer;
  }

  /* Highlight of the hovered element and what it connects. */
  .lc-diagram :global(.loop.hl .loop-wire),
  .lc-diagram :global(.repeat.hl .wire) {
    stroke-width: 2.5;
    stroke-dasharray: none;
    stroke: var(--accent);
  }

  .lc-diagram :global(.loop.hl .loop-label-bg) {
    fill: var(--ink);
  }

  .lc-diagram :global(.loop.hl .loop-label) {
    fill: var(--surface);
  }

  .lc-diagram :global(.phase.hl > .box) {
    stroke-width: 2.5;
    stroke: var(--accent);
  }

  .tip {
    position: fixed;
    z-index: 20;
    max-width: 320px;
    padding: 8px 10px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 0.85rem;
    line-height: 1.45;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .tip[hidden] {
    display: none;
  }

  .tip-meta:empty,
  .tip-body:empty {
    display: none;
  }

  .tip-body {
    color: var(--muted);
    white-space: pre-line;
  }

  .lc-diagram :global(.head) {
    fill: var(--ink);
  }

  .lc-diagram :global(.box) {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .lc-diagram :global(.step) {
    fill: var(--ink);
  }

  .lc-diagram :global(.step-text) {
    fill: var(--surface);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
  }

  .lc-diagram :global(.name) {
    fill: var(--text);
    font-size: 14px;
    font-weight: 600;
  }

  .lc-diagram :global(.tag rect) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .lc-diagram :global(.tag text) {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
  }

  .lc-diagram :global(.tag:hover rect),
  .lc-diagram :global(.tag:focus-visible rect) {
    stroke-width: 2.5;
  }

  .lc-diagram :global(.tag.origin-standards-and-literature rect) {
    fill: var(--origin-sl-bg);
  }

  .lc-diagram :global(.tag.origin-standards-and-literature text) {
    fill: var(--origin-sl-text);
  }

  .lc-diagram :global(.tag.origin-standards-only rect) {
    fill: var(--origin-so-bg);
  }

  .lc-diagram :global(.tag.origin-standards-only text) {
    fill: var(--origin-so-text);
  }

  .lc-diagram :global(.tag.origin-decomposed rect) {
    fill: var(--origin-dec-bg);
  }

  .lc-diagram :global(.tag.origin-decomposed text) {
    fill: var(--origin-dec-text);
  }

  .lc-diagram :global(.loop-label-bg) {
    fill: var(--surface);
    stroke: var(--ink);
  }

  .lc-diagram :global(.loop-label) {
    fill: var(--text);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
  }

  .legend-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
    color: var(--muted);
  }

  .key {
    display: inline-block;
    min-width: 22px;
    margin-right: 6px;
    text-align: center;
    font-family: var(--mono);
    color: var(--text);
  }

  .key-loop {
    border: 1px solid var(--ink);
    font-size: 0.72rem;
    padding: 0 3px;
  }

  .lc-loops ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    max-width: var(--measure);
  }

  .lc-loops li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .loop-id {
    border: 1px solid var(--ink);
    padding: 0 6px;
    font-size: 0.78rem;
  }

  .lc-loops p {
    margin: 2px 0 0;
  }
</style>
