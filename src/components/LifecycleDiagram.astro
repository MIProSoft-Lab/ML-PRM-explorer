---
// Diagram of a lifecycle model: phases in order, repeated phases with a
// circular arrow, and feedback loops as numbered arcs back to earlier phases.
// It is drawn twice, left to right for wide screens and top to bottom for
// narrow ones, and the stylesheet shows the one that fits.
import { getProcess, type Lifecycle } from '../lib/content';
import { useTranslations, href, type Locale } from '../i18n/ui';
import { plain } from '../lib/text';

interface Props {
  locale: Locale;
  lifecycle: Lifecycle;
}

const { locale, lifecycle: l } = Astro.props;
const t = useTranslations(locale);

/** Greedy word wrap by character count; SVG text does not wrap by itself. */
function wrap(text: string, max: number) {
  const lines: string[] = [];
  let line = '';
  for (const word of text.split(/\s+/)) {
    if (line && (line + ' ' + word).length > max) {
      lines.push(line);
      line = word;
    } else {
      line = line ? `${line} ${word}` : word;
    }
  }
  if (line) lines.push(line);
  return lines;
}

const index = new Map(l.phases.map((p, i) => [p.id, i]));
const phases = l.phases.map((ph, i) => ({
  ...ph,
  n: String(i + 1).padStart(2, '0'),
  procs: ph.processes.map((pid) => {
    const p = getProcess(l.prmVersion, pid, locale).data;
    return { id: pid, name: p.name, origin: p.origin, purpose: plain(p.purpose) };
  }),
}));

// Feedback loops, numbered in order of appearance. A loop to the same phase
// is drawn as a repetition instead.
const loops = l.phases
  .map((ph, i) => ({ from: i, to: ph.returnsTo ? index.get(ph.returnsTo) : undefined, note: ph.returnNote }))
  .filter((x): x is { from: number; to: number; note: string | undefined } => x.to !== undefined && x.to !== x.from)
  .map((x, k) => ({ ...x, label: `L${k + 1}` }));
// Loops that leave or reach the same phase get their own attachment point,
// spread around the middle of the box, so their arrowheads do not overlap.
const spread = (k: number, key: 'from' | 'to') => {
  const same = loops.filter((x) => x[key] === loops[k][key]);
  return same.indexOf(loops[k]) - (same.length - 1) / 2;
};
const repeated = (i: number) => l.phases[i].iterative || l.phases[i].returnsTo === l.phases[i].id;

const TAG_W = 38;
const TAG_H = 18;
const TAG_GAP = 5;

// --- Left to right ---------------------------------------------------------

const H = (() => {
  const W = 160;
  const GAP = 46;
  const TOP = 40;
  const LEFT = 8;
  const perRow = Math.floor((W - 16 + TAG_GAP) / (TAG_W + TAG_GAP));
  const names = phases.map((p) => wrap(p.name, 19));
  const nameLines = Math.max(...names.map((n) => n.length));
  const tagRows = Math.max(...phases.map((p) => Math.ceil(p.procs.length / perRow)));
  const boxH = 36 + nameLines * 17 + 8 + tagRows * (TAG_H + TAG_GAP) + 6;
  const boxes = phases.map((p, i) => ({
    x: LEFT + i * (W + GAP),
    y: TOP,
    w: W,
    h: boxH,
    name: names[i],
    tags: p.procs.map((proc, k) => ({
      ...proc,
      x: LEFT + i * (W + GAP) + 8 + (k % perRow) * (TAG_W + TAG_GAP),
      y: TOP + 36 + nameLines * 17 + 8 + Math.floor(k / perRow) * (TAG_H + TAG_GAP),
    })),
  }));
  const bottom = TOP + boxH;
  const arcs = loops.map((loop, k) => {
    const a = boxes[loop.from];
    const b = boxes[loop.to];
    const sx = a.x + a.w / 2 + spread(k, 'from') * 20;
    const tx = b.x + b.w / 2 + spread(k, 'to') * 20;
    const depth = 46 + k * 30;
    return {
      ...loop,
      d: `M${sx} ${bottom} C${sx} ${bottom + depth}, ${tx} ${bottom + depth}, ${tx} ${bottom + 3}`,
      lx: (sx + tx) / 2,
      ly: bottom + depth * 0.75,
    };
  });
  const width = LEFT * 2 + phases.length * W + (phases.length - 1) * GAP;
  const height = bottom + (loops.length ? 46 + (loops.length - 1) * 30 + 20 : 16);
  return { boxes, arcs, width, height, bottom };
})();

// --- Top to bottom ---------------------------------------------------------

const V = (() => {
  const LEFT = 44;
  const W = 232;
  const GAP = 40;
  const perRow = Math.floor((W - 16 + TAG_GAP) / (TAG_W + TAG_GAP));
  let y = 8;
  const boxes = phases.map((p) => {
    const name = wrap(p.name, 26);
    const rows = Math.ceil(p.procs.length / perRow);
    const h = 36 + name.length * 17 + 8 + rows * (TAG_H + TAG_GAP) + 6;
    const box = {
      x: LEFT,
      y,
      w: W,
      h,
      name,
      tags: p.procs.map((proc, k) => ({
        ...proc,
        x: LEFT + 8 + (k % perRow) * (TAG_W + TAG_GAP),
        y: y + 36 + name.length * 17 + 8 + Math.floor(k / perRow) * (TAG_H + TAG_GAP),
      })),
    };
    y += h + GAP;
    return box;
  });
  const right = LEFT + W;
  const arcs = loops.map((loop, k) => {
    const a = boxes[loop.from];
    const b = boxes[loop.to];
    const sy = a.y + a.h / 2 + spread(k, 'from') * 14;
    const ty = b.y + b.h / 2 + spread(k, 'to') * 14;
    const x = right + 22 + k * 22;
    return { ...loop, d: `M${right} ${sy} H${x} V${ty} H${right + 3}`, lx: x, ly: (sy + ty) / 2 };
  });
  const width = right + 22 + Math.max(loops.length, 1) * 22 + 20;
  return { boxes, arcs, width, height: y - GAP + 8 };
})();

// Hover information. Each element carries a title and a body of plain text.
const snippet = (text: string, max = 190) => (text.length <= max ? text : `${text.slice(0, text.lastIndexOf(' ', max))}…`);
const tipTag = (proc: (typeof phases)[number]['procs'][number]) => ({
  'data-tip-title': `${proc.id} · ${proc.name}`,
  'data-tip-meta': t(`origin.${proc.origin}`),
  'data-tip-body': snippet(proc.purpose),
});
const tipPhase = (i: number) => {
  const ph = phases[i];
  const lines = [
    t('lc.tipProcesses', { n: ph.procs.length }),
    ...(repeated(i) ? [t('lc.legendRepeated')] : []),
    ...loops.filter((x) => x.from === i).map((x) => t('lc.tipReturns', { loop: x.label, phase: phases[x.to].name })),
    ...loops.filter((x) => x.to === i).map((x) => t('lc.tipReceives', { loop: x.label, phase: phases[x.from].name })),
  ];
  return {
    'data-tip-title': `${ph.n} · ${ph.name}`,
    'data-tip-body': [ph.description && plain(ph.description), ...lines].filter(Boolean).join('\n'),
  };
};
const tipLoop = (loop: (typeof loops)[number]) => ({
  'data-tip-title': `${loop.label} · ${phases[loop.from].name} → ${phases[loop.to].name}`,
  'data-tip-meta': t('lc.legendLoop'),
  'data-tip-body': loop.note ?? '',
});
const tipRepeat = (i: number) => ({
  'data-tip-title': `↻ ${phases[i].name}`,
  'data-tip-body': t('lc.legendRepeated'),
});

const desc = t('lc.diagramDesc', { phases: phases.map((p) => p.name).join(', ') });
const loopText = (loop: (typeof loops)[number]) => `${phases[loop.from].name} → ${phases[loop.to].name}`;
const procHref = (pid: string) => href(locale, l.prmVersion, 'processes', pid);
---

<figure class="lc-diagram grid-paper">
  <div class="tools no-print">
    <span class="hint small muted">{t('lc.zoomHint')}</span>
    <div class="pills" role="group" aria-label={t('lc.zoom')}>
      <button type="button" data-zoom="out" aria-label={t('lc.zoomOut')} title={t('lc.zoomOut')}>−</button>
      <button type="button" data-zoom="fit" aria-label={t('lc.zoomFit')} title={t('lc.zoomFit')}><span class="level">100%</span></button>
      <button type="button" data-zoom="in" aria-label={t('lc.zoomIn')} title={t('lc.zoomIn')}>+</button>
    </div>
  </div>
  <div class="viewport" tabindex="0" aria-label={t('lc.zoomHint')}>
  {
    [
      { key: 'h', g: H, horizontal: true },
      { key: 'v', g: V, horizontal: false },
    ].map(({ key, g, horizontal }) => (
      <svg
        class={`diagram diagram-${key}`}
        viewBox={`0 0 ${g.width} ${g.height}`}
        role="img"
        aria-labelledby={`lc-title-${key} lc-desc-${key}`}
      >
        <title id={`lc-title-${key}`}>{t('lc.diagram', { name: l.name })}</title>
        <desc id={`lc-desc-${key}`}>{desc}</desc>
        <defs>
          <marker id={`head-${key}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L8 4 L0 8 z" class="head" />
          </marker>
        </defs>

        {/* Forward arrows between consecutive phases */}
        {g.boxes.slice(1).map((b, i) => {
          const a = g.boxes[i];
          return horizontal ? (
            <line class="wire" x1={a.x + a.w} y1={a.y + 24} x2={b.x - 2} y2={b.y + 24} marker-end={`url(#head-${key})`} />
          ) : (
            <line class="wire" x1={a.x + 40} y1={a.y + a.h} x2={b.x + 40} y2={b.y - 2} marker-end={`url(#head-${key})`} />
          );
        })}

        {/* Feedback loops */}
        {g.arcs.map((arc) => (
          <g class="loop" data-from={arc.from} data-to={arc.to} {...tipLoop(arc)}>
            <path class="hit" d={arc.d} />
            <path class="wire loop-wire" d={arc.d} marker-end={`url(#head-${key})`} />
            <rect class="loop-label-bg" x={arc.lx - 13} y={arc.ly - 9} width="26" height="18" />
            <text class="loop-label" x={arc.lx} y={arc.ly + 4} text-anchor="middle">
              {arc.label}
            </text>
          </g>
        ))}

        {g.boxes.map((b, i) => (
          <g class="phase" data-phase={i} {...tipPhase(i)}>
            {/* Repetition: a circular arrow above the box (or to its left when vertical) */}
            {repeated(i) &&
              (() => {
                const d = horizontal
                  ? `M${b.x + b.w * 0.66} ${b.y} C${b.x + b.w * 0.66} ${b.y - 34}, ${b.x + b.w * 0.34} ${b.y - 34}, ${b.x + b.w * 0.34} ${b.y - 3}`
                  : `M${b.x} ${b.y + b.h * 0.3} C${b.x - 34} ${b.y + b.h * 0.3}, ${b.x - 34} ${b.y + b.h * 0.7}, ${b.x - 3} ${b.y + b.h * 0.7}`;
                return (
                  <g class="repeat" {...tipRepeat(i)}>
                    <path class="hit" d={d} />
                    <path class="wire" d={d} marker-end={`url(#head-${key})`} />
                  </g>
                );
              })()}
            <rect class="box" x={b.x} y={b.y} width={b.w} height={b.h} />
            <rect class="step" x={b.x + 8} y={b.y + 8} width="24" height="16" />
            <text class="step-text" x={b.x + 20} y={b.y + 20} text-anchor="middle">
              {phases[i].n}
            </text>
            {b.name.map((line, k) => (
              <text class="name" x={b.x + 8} y={b.y + 44 + k * 17}>
                {line}
              </text>
            ))}
            {b.tags.map((tag) => (
              <a href={procHref(tag.id)} class={`tag origin-${tag.origin}`} data-process={tag.id} data-version={l.prmVersion} data-name={tag.name} aria-label={`${tag.id} ${tag.name}`} {...tipTag(tag)}>
                <rect x={tag.x} y={tag.y} width={TAG_W} height={TAG_H} />
                <text x={tag.x + TAG_W / 2} y={tag.y + 13} text-anchor="middle">
                  {tag.id}
                </text>
              </a>
            ))}
          </g>
        ))}
      </svg>
    ))
  }
  </div>
  <div class="tip" role="tooltip" hidden>
    <strong class="tip-title"></strong>
    <span class="tip-meta label"></span>
    <span class="tip-body"></span>
  </div>

  <figcaption class="legend-list small">
    <span><span class="key key-next" aria-hidden="true">→</span>{t('lc.legendNext')}</span>
    <span><span class="key" aria-hidden="true">↻</span>{t('lc.legendRepeated')}</span>
    <span><span class="key key-loop" aria-hidden="true">L1</span>{t('lc.legendLoop')}</span>
  </figcaption>
</figure>

{
  loops.length > 0 && (
    <section class="loops">
      <h2>{t('lc.loops')}</h2>
      <ol>
        {loops.map((loop) => (
          <li>
            <span class="loop-id mono">{loop.label}</span>
            <div>
              <strong>{loopText(loop)}</strong>
              {loop.note && <p class="muted small">{loop.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}

<script>
  // Zooming and moving around the diagram, and the hover information.
  // Zoom changes the viewBox of the visible drawing, so text stays sharp.
  const MIN = 1;
  const MAX = 4;
  const clamp = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x));

  interface View {
    W: number;
    H: number;
    x: number;
    y: number;
    k: number;
  }

  function init(fig: HTMLElement) {
    const viewport = fig.querySelector<HTMLElement>('.viewport')!;
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const level = fig.querySelector<HTMLElement>('.level')!;
    const svgs = [...fig.querySelectorAll<SVGSVGElement>('svg.diagram')];
    const views = new Map<SVGSVGElement, View>(
      svgs.map((svg) => {
        const [, , W, H] = svg.getAttribute('viewBox')!.split(' ').map(Number);
        return [svg, { W, H, x: 0, y: 0, k: 1 }];
      }),
    );
    // Both drawings are in the page; the stylesheet shows one of them.
    const active = () => svgs.find((svg) => svg.getBoundingClientRect().width > 0) ?? svgs[0];

    function apply(svg: SVGSVGElement) {
      const v = views.get(svg)!;
      const w = v.W / v.k;
      const h = v.H / v.k;
      v.x = clamp(v.x, 0, v.W - w);
      v.y = clamp(v.y, 0, v.H - h);
      svg.setAttribute('viewBox', `${v.x} ${v.y} ${w} ${h}`);
      if (svg === active()) {
        viewport.classList.toggle('zoomed', v.k > 1.001);
        level.textContent = `${Math.round(v.k * 100)}%`;
      }
    }

    /** Zoom by a factor around a point given in client coordinates (the centre by default). */
    function zoomAt(factor: number, cx?: number, cy?: number) {
      const svg = active();
      const v = views.get(svg)!;
      const r = svg.getBoundingClientRect();
      const fx = cx === undefined ? 0.5 : (cx - r.left) / r.width;
      const fy = cy === undefined ? 0.5 : (cy - r.top) / r.height;
      const px = v.x + (fx * v.W) / v.k;
      const py = v.y + (fy * v.H) / v.k;
      v.k = clamp(v.k * factor, MIN, MAX);
      v.x = px - (fx * v.W) / v.k;
      v.y = py - (fy * v.H) / v.k;
      apply(svg);
    }

    function panBy(dx: number, dy: number) {
      const svg = active();
      const v = views.get(svg)!;
      const r = svg.getBoundingClientRect();
      v.x -= (dx / r.width) * (v.W / v.k);
      v.y -= (dy / r.height) * (v.H / v.k);
      apply(svg);
    }

    function fit() {
      const svg = active();
      Object.assign(views.get(svg)!, { x: 0, y: 0, k: 1 });
      apply(svg);
    }

    const zoomed = () => views.get(active())!.k > 1.001;

    fig.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.zoom === 'in') zoomAt(1.25);
        if (b.dataset.zoom === 'out') zoomAt(0.8);
        if (b.dataset.zoom === 'fit') fit();
      }),
    );

    // Ctrl + wheel, which is also what a trackpad pinch sends. A plain wheel
    // keeps scrolling the page.
    viewport.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        // A trackpad pinch sends many small steps, a mouse wheel few large
        // ones (about 100 per notch, or lines). Scale both to a gentle zoom.
        const pinch = e.deltaMode === 0 && Math.abs(e.deltaY) < 50;
        const delta = e.deltaMode === 1 ? e.deltaY * 33 : e.deltaY;
        zoomAt(Math.exp(-delta * (pinch ? 0.01 : 0.002)), e.clientX, e.clientY);
      },
      { passive: false },
    );

    viewport.addEventListener('keydown', (e) => {
      const step = 40;
      const keys: Record<string, () => void> = {
        '+': () => zoomAt(1.25),
        '=': () => zoomAt(1.25),
        '-': () => zoomAt(0.8),
        '0': fit,
        ArrowLeft: () => panBy(step, 0),
        ArrowRight: () => panBy(-step, 0),
        ArrowUp: () => panBy(0, step),
        ArrowDown: () => panBy(0, -step),
      };
      const action = keys[e.key];
      if (!action || (e.key.startsWith('Arrow') && !zoomed())) return;
      e.preventDefault();
      action();
    });

    // Drag to move when zoomed, and pinch with two fingers.
    const pointers = new Map<number, { x: number; y: number }>();
    let dragging = false;
    let moved = 0;
    let suppressClick = false;

    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      moved = 0;
    });

    viewport.addEventListener('pointermove', (e) => {
      const last = pointers.get(e.pointerId);
      if (!last) return;
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const other = a === last ? b : a;
        const before = Math.hypot(last.x - other.x, last.y - other.y);
        const after = Math.hypot(e.clientX - other.x, e.clientY - other.y);
        if (before > 0) zoomAt(after / before, (e.clientX + other.x) / 2, (e.clientY + other.y) / 2);
        dragging = true;
      } else if (zoomed()) {
        moved += Math.abs(e.clientX - last.x) + Math.abs(e.clientY - last.y);
        if (moved > 4 && !dragging) {
          dragging = true;
          viewport.setPointerCapture(e.pointerId);
          viewport.classList.add('dragging');
          hideTip();
        }
        if (dragging) panBy(e.clientX - last.x, e.clientY - last.y);
      }
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    });

    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size === 0 && dragging) {
        dragging = false;
        suppressClick = true;
        viewport.classList.remove('dragging');
        setTimeout(() => (suppressClick = false));
      }
    };
    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);

    // A drag that ends over a process must not open it.
    viewport.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    // --- Hover information ----------------------------------------------

    let current: Element | null = null;

    function highlight(el: Element | null) {
      fig.querySelectorAll('.hl').forEach((x) => x.classList.remove('hl'));
      if (!el) return;
      const svg = el.closest('svg')!;
      const phase = (i: string | null) => svg.querySelector(`.phase[data-phase="${i}"]`);
      el.classList.add('hl');
      if (el.matches('.loop')) {
        phase(el.getAttribute('data-from'))?.classList.add('hl');
        phase(el.getAttribute('data-to'))?.classList.add('hl');
      } else if (el.matches('.phase')) {
        const i = el.getAttribute('data-phase');
        svg.querySelectorAll(`.loop[data-from="${i}"], .loop[data-to="${i}"]`).forEach((x) => x.classList.add('hl'));
      } else if (el.matches('.repeat')) {
        el.closest('.phase')?.classList.add('hl');
      }
    }

    function showTip(el: Element) {
      if (el === current) return;
      current = el;
      tip.querySelector('.tip-title')!.textContent = el.getAttribute('data-tip-title');
      tip.querySelector('.tip-meta')!.textContent = el.getAttribute('data-tip-meta') ?? '';
      tip.querySelector('.tip-body')!.textContent = el.getAttribute('data-tip-body') ?? '';
      tip.hidden = false;
      highlight(el.matches('.tag') ? null : el);
    }

    function hideTip() {
      current = null;
      tip.hidden = true;
      highlight(null);
    }

    /** Place the tooltip next to a point, inside the window. */
    function placeTip(x: number, y: number) {
      const r = tip.getBoundingClientRect();
      const left = x + 14 + r.width > innerWidth - 8 ? x - 14 - r.width : x + 14;
      const top = y + 16 + r.height > innerHeight - 8 ? y - 12 - r.height : y + 16;
      tip.style.left = `${clamp(left, 8, innerWidth - r.width - 8)}px`;
      tip.style.top = `${clamp(top, 8, innerHeight - r.height - 8)}px`;
    }

    const tipTarget = (t: EventTarget | null) => (t instanceof Element ? t.closest('[data-tip-title]') : null);

    viewport.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      if (dragging) return;
      const el = tipTarget(e.target);
      if (!el) return hideTip();
      showTip(el);
      placeTip(e.clientX, e.clientY);
    });
    viewport.addEventListener('pointerleave', hideTip);

    // Touch has no hover: a tap on a phase or a loop shows its information.
    viewport.addEventListener('click', (e) => {
      const el = tipTarget(e.target);
      if (!el || el.matches('.tag')) return;
      if (el === current && (e as PointerEvent).pointerType !== 'mouse') return hideTip();
      current = null;
      showTip(el);
      placeTip(e.clientX, e.clientY);
    });
    document.addEventListener('pointerdown', (e) => {
      if (!viewport.contains(e.target as Node)) hideTip();
    });

    // Keyboard focus on a process shows its information below it.
    viewport.addEventListener('focusin', (e) => {
      const el = tipTarget(e.target);
      if (!el) return;
      showTip(el);
      const r = el.getBoundingClientRect();
      placeTip(r.left, r.bottom - 8);
    });
    viewport.addEventListener('focusout', hideTip);
    addEventListener('scroll', hideTip, { passive: true });

    // Switching between the wide and the narrow drawing shows the other one's zoom.
    matchMedia('(max-width: 860px)').addEventListener('change', () => apply(active()));
  }

  document.querySelectorAll<HTMLElement>('.lc-diagram').forEach(init);
</script>

<style>
  .lc-diagram {
    margin: 20px 0 8px;
    padding: 0 16px 16px;
    border: 1px solid var(--ink);
    position: relative;
  }

  .tools {
    display: flex;
    justify-content: flex-end;
