---
import { getProcess, type Lifecycle } from '../lib/content';
import { inline } from '../lib/text';
import { useTranslations, href, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  lifecycle: Lifecycle;
  compact?: boolean;
}

const { locale, lifecycle: l, compact = false } = Astro.props;
const t = useTranslations(locale);
const phaseName = (id: string) => l.phases.find((p) => p.id === id)?.name ?? id;
---

<ol class:list={['phases', { compact, 'grid-paper': !compact }]}>
  {
    l.phases.map((ph, i) => (
      <li class="phase" id={compact ? undefined : `phase-${ph.id}`}>
        <div class="phase-head">
          <span class="step">{String(i + 1).padStart(2, '0')}</span>
          <strong>{ph.name}</strong>
          {ph.iterative && (
            <span class="badge" title={t('lc.iterative')}>
              ↻ {t('lc.iterative')}
            </span>
          )}
        </div>
        {!compact && ph.description && <p class="small muted" set:html={inline(ph.description)} />}
        <ul class="procs">
          {ph.processes.map((pid) => {
            const p = getProcess(l.prmVersion, pid, locale).data;
            return (
              <li>
                <a class={`proc origin-${p.origin}`} href={href(locale, l.prmVersion, 'processes', pid)} data-process={pid} data-version={l.prmVersion} data-name={p.name}>
                  <span class="num">{pid}</span>
                  {!compact && <span>{p.name}</span>}
                </a>
              </li>
            );
          })}
        </ul>
        {!compact && ph.returnsTo && (
          <p class="return small">
            <strong>↩ {t('lc.returnsTo', { phase: phaseName(ph.returnsTo) })}</strong>
            {ph.returnNote && <span class="muted"> {ph.returnNote}</span>}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .phases {
    list-style: none;
    padding: 0;
    margin: 16px 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }

  .phases.grid-paper {
    padding: 20px;
    border: 1px solid var(--ink);
  }

  .phase {
    background: var(--surface);
    border: 1px solid var(--ink);
    padding: 0 0 12px;
  }

  /* The name stays beside the number, wrapping in its own column; the
     iterative badge goes below the name. */
  .phase-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 6px 8px;
    align-items: baseline;
    padding: 8px 12px;
    border-bottom: 1px solid var(--ink);
  }

  .phase-head strong {
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .phase-head .badge {
    grid-column: 2;
    justify-self: start;
  }

  .phase > p,
  .procs,
  .return {
    margin-left: 12px;
    margin-right: 12px;
  }

  .step {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0 6px;
    background: var(--ink-fill);
    color: var(--surface);
  }

  .procs {
    list-style: none;
    padding: 0;
    margin-top: 12px;
    margin-bottom: 0;
    display: grid;
    gap: 6px;
  }

  .proc {
    display: flex;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .proc:hover {
    box-shadow: 2px 2px 0 var(--ink);
  }

  .proc .num {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.8;
    padding-top: 1px;
  }

  .return {
    margin-top: 12px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }

  .compact {
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 6px;
    margin: 12px 0 0;
  }

  .compact .phase {
    padding: 0 0 6px;
    font-size: 0.8rem;
  }

  .compact .phase-head {
    padding: 4px 6px;
  }

  .compact .procs {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin: 6px 6px 0;
  }

  .compact .proc {
    padding: 0 4px;
  }

  .compact .badge {
    display: none;
  }
</style>
