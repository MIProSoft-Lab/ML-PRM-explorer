---
import { useTranslations, href, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  items?: { version: string; process: string; activity: string }[];
}

const { locale, items = [] } = Astro.props;
const t = useTranslations(locale);
---

{
  items.length > 0 && (
    <div class="cited small">
      <span class="muted">{t('refs.citedBy')}:</span>
      {items.map((c) => (
        <a class="chip" href={`${href(locale, c.version, 'processes', c.process)}#activity-${c.activity}`}>
          {c.process}·{c.activity}
          {c.version && <span class="num">{c.version}</span>}
        </a>
      ))}
    </div>
  )
}

<style>
  .cited {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    margin-top: 4px;
  }

  .chip {
    font-size: 0.75rem;
    padding: 0 6px;
  }
</style>
